# ----- gamY: Initialize industries_energy_demand equation block -----

# ----- gamY: Initialize industries_energy_demand_endogenous group -----
EQUATION E_qEpj_inNest[es,e,i,t];
E_qEpj_inNest[es,e,i,t]$(((t.val>=t1.val and t.val<=tend.val) and (d1pepj_marg_innest[es,e,i,t])) and qepj_exists_dummy[es,e,i,t])..  
				qEpj[es,e,i,t]  =E=  (uEpj[es,e,i,t] * (pEpj_marg[es,e,i,t]/pREes[es,i,t])**(-eEpj[es,i]) * qREes[es,i,t])$(not d1switch_integrate_energy_technology)
				                + (uEpj[es,e,i,t] * qREes[es,i,t])$(d1switch_integrate_energy_technology)
				                ;
EQUATION E_pREes_es_i[es,i,t];
E_pREes_es_i[es,i,t]$(((t.val>=t1.val and t.val<=tend.val) and (d1pees[es,i,t])) and prees_exists_dummy[es,i,t])..  pREes[es,i,t]*qREes[es,i,t] 
																					 =E=  sum((e)$(d1pEpj_marg_inNest[es,e,i,t]), pEpj_marg[es,e,i,t] * qEpj[es,e,i,t])
																						+ vESK[es,i,t];
EQUATION E_qREes_machine_energy[es,i,t];
E_qREes_machine_energy[es,i,t]$(((t.val>=t1.val and t.val<=tend.val) and (d1pees[es,i,t] and not (heating[es] or transport[es]))) and qrees_exists_dummy[es,i,t]).. 
