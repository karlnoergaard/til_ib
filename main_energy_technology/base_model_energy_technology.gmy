# ------------------------------------------------------------------------------

# ----- gamY: IF "calibration" == "calibration": -----



# ----- gamY: Initialize energy_technology_calibration equation block -----

# ----- gamY: Initialize energy_technology_calibration_endogenous group -----
EQUATION E_qK_k_ienergy_tech[k,i,t];
E_qK_k_ienergy_tech[k,i,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology) and (t1[t] and d1qi_k_i_energy_tech[k,i,t])) and qk_k_i_exists_dummy[k,i,t]).. 
    pK_k_i[k,i,t]*qK_k_i[k,i,t]  =E=  pK_k_i_baseline[k,i,t]*qK_k_i_baseline[k,i,t] 
                                  - vI_k_i_energy_tech[k,i,t];
EQUATION E_jES_es_i[es,i,t];
E_jES_es_i[es,i,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology) and (not t1[t] and d1qes[es,i,t1])) and jes_exists_dummy[es,i,t]).. 
    jES[es,i,t]  =E=  jES[es,i,t1];
EQUATION E_jqESE_es_e_i[es,e,i,t];
E_jqESE_es_e_i[es,e,i,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology) and (not t1[t] and d1pepj_marg[es,e,i,t] and d1qes[es,i,t])) and jqese_exists_dummy[es,e,i,t]).. 
    jqESE[es,e,i,t]  =E=  jqESE[es,e,i,t1]*jqESE_phaseout[t];

# ----- gamY: Initialize energy_technology_calibration model -----
MODEL energy_technology_calibration / 
E_qK_k_ienergy_tech, E_jES_es_i, E_jqESE_es_e_i
 /;

model calibration / 
  energy_technology_equations
  energy_technology_calibration
/;

