E_pTK_i[i,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology and d1switch_integrate_energy_technology)) and ptk_exists_dummy[i,t])..  pTK[i,t]  =E=  pD['iM',t]*jpTK[i,t];
