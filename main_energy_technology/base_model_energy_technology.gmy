E_qPFtop2qY_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qpftop2qy_exists_dummy[i,t]).. 
      pY0_i[i,t] * qY0_i[i,t]  =E=  sum(out, pY0_CET[out,i,t] * qY_CETgross[out,i,t]);
EQUATION E_jvY_i[i,t];
E_jvY_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and jvy_i_exists_dummy[i,t]).. 
         vY_i[i,t]  =E=  sum(out, pY_CET[out,i,t]*qY_CET[out,i,t]) + jvY_i[i,t];
EQUATION E_jvM_i[i,t];
E_jvM_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and jvm_i_exists_dummy[i,t]).. 
         vM_i[i,t]  =E=  sum(out, pM_CET[out,i,t]*qM_CET[out,i,t]) + sum(e,vDistributionProfits[e,t])$(i_refineries[i]) + jvM_i[i,t];

