      )
    
      loop([out,i,t]$((tDataEnd[t]) and (t.val <= 2020)),
        abort$(qY_CETown_difference[out,i,t] <> 0) 'qY_CETown_difference exceeds allowed threshold! "data_covered_variables does not change more than previously done so by calibration."';
      )
    
      loop([l,es,d,t]$(tDataEnd[t]),
        abort$(sqTPotential_difference[l,es,d,t] <> 0) 'sqTPotential_difference exceeds allowed threshold! "data_covered_variables does not change more than previously done so by calibration."';
      )
    
      loop([l,es,e,d,t]$(tDataEnd[t]),
        abort$(uTE_difference[l,es,e,d,t] <> 0) 'uTE_difference exceeds allowed threshold! "data_covered_variables does not change more than previously done so by calibration."';
      )
    
      loop([l,es,d,t]$(tDataEnd[t]),
        abort$(uTI_difference[l,es,d,t] <> 0) 'uTI_difference exceeds allowed threshold! "data_covered_variables does not change more than previously done so by calibration."';
      )
    
      loop([l,es,d,t]$(tDataEnd[t]),
        abort$(uTC_difference[l,es,d,t] <> 0) 'uTC_difference exceeds allowed threshold! "data_covered_variables does not change more than previously done so by calibration."';
      )
    
      loop([d,t]$(tDataEnd[t]),
        abort$(pTK_difference[d,t] <> 0) 'pTK_difference exceeds allowed threshold! "data_covered_variables does not change more than previously done so by calibration."';
      )
    
      loop([es,d,t]$(tDataEnd[t]),
        abort$(qES_difference[es,d,t] <> 0) 'qES_difference exceeds allowed threshold! "data_covered_variables does not change more than previously done so by calibration."';
      )
$onlisting
; #Ideally this check should be done rather than "diff-in-diff" above


