		qEtot.l[e,t] = sum(i, qY_CET.l[e,i,t] + qM_CET.l[e,i,t]);

		pE_avg.l[e,t]$(qEtot.l[e,t])
			= (sum(i, pY_CET.l[e,i,t]*qY_CET.l[e,i,t]) 
			 + sum(i, pM_CET.l[e,i,t]*qM_CET.l[e,i,t]))
			 / qEtot.l[e,t];


