EQUATION E_qY_CET_out_other_i[out_other,i,t];
E_qY_CET_out_other_i[out_other,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qy_cet_exists_dummy[out_other,i,t]).. qY_CET[out_other,i,t]  =E=  sum(d_non_ene,qY_i_d[i,d_non_ene,t]/ (1+tY_i_d[i,d_non_ene,tBase])) + qD_E_margins[i,t] + jqY_CET_tDataEnd[out_other,i]$(tDataEnd[t]);
EQUATION E_qM_CET_out_other_i[out_other,i,t];
E_qM_CET_out_other_i[out_other,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qm_cet_exists_dummy[out_other,i,t]).. qM_CET[out_other,i,t]  =E=  sum(d_non_ene,qM_i_d[i,d_non_ene,t]/ (1+tM_i_d[i,d_non_ene,tBase])) + jqM_CET_tDataEnd[out_other,i]$(tDataEnd[t]);
EQUATION E_jfpY_i_d[i,d,t];
E_jfpY_i_d[i,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1y_i_nepnei[i,t] and d1y_i_d[i,d,t] and d_non_ene[d] and not i_energymargins[i] and t.val>tdataend.val)) and jfpy_i_d_exists_dummy[i,d,t]).. 
							jfpY_i_d[i,d,t]  =E=  adj_jfpY_i_d[i,t];
