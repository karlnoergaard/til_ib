MODEL energy_technology_equations_output / 
E_qESE_es_e_d, E_qESK_es_d, E_vES_es_d, E_pES_es_d, E_vESK_es_d
 /;


# ----- gamY: Initialize energy_technology_equations_links equation block -----

# ----- gamY: Initialize energy_technology_endogenous_links group -----
EQUATION E_qES_es_i[es,i,t];
E_qES_es_i[es,i,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology and d1switch_integrate_energy_technology)) and qes_exists_dummy[es,i,t])..  qES[es,i,t]  =E=  jES[es,i,t]*qREes[es,i,t];
