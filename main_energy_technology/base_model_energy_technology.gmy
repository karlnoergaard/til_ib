E_tCO2_Emarg_pj_notNatgas[em,es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (not natgas[e])) and tco2_emarg_pj_exists_dummy[em,es,e,d,t])..  tCO2_Emarg_pj[em,es,e,d,t]  =E=  tCO2_Emarg[em,es,e,d,t] /10**6 * uEmmE_BU[em,es,e,d,t];
EQUATION E_tCO2_Emarg_pj_NatgasBio[em,es,e,d,t];
E_tCO2_Emarg_pj_NatgasBio[em,es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (natgas[e] and co2bio[em])) and tco2_emarg_pj_exists_dummy[em,es,e,d,t])..  
            tCO2_Emarg_pj[em,es,e,d,t]  =E=  tCO2_Emarg[em,es,e,d,t] /10**6 * uEmmE_BU[em,es,e,d,t] * sBioNatGas[t];
EQUATION E_tCO2_Emarg_pj_NatgasuBio[em,es,e,d,t];
E_tCO2_Emarg_pj_NatgasuBio[em,es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (natgas[e] and co2ubio[em])) and tco2_emarg_pj_exists_dummy[em,es,e,d,t])..  
              tCO2_Emarg_pj[em,es,e,d,t]  =E=  tCO2_Emarg[em,es,e,d,t] /10**6 * uEmmE_BU[em,es,e,d,t] * (1-sBioNatGas[t]);
EQUATION E_tEmarg_duty_etaxes_es_e_d[etaxes,es,e,d,t];
E_tEmarg_duty_etaxes_es_e_d[etaxes,es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (sum(em,d1tco2_e[em,es,e,d,t]) and d1te_duty[etaxes,es,e,d,t] and co2_tax[etaxes])) and temarg_duty_exists_dummy[etaxes,es,e,d,t])..  
            tEmarg_duty[etaxes,es,e,d,t]  =E=  sum(em$(d1tCO2_E[em,es,e,d,t]), tCO2_Emarg_pj[em,es,e,d,t]);
EQUATION E_vtCO2_xE_d[d,t];
E_vtCO2_xE_d[d,t]$(((t1.val <= t.val and t.val <= tend.val)) and vtco2_xe_exists_dummy[d,t])..  vtCO2_xE[d,t]  =E=   tCO2_xEmarg[d,t]/10**6 * qEmmxE['CO2e',d,t];
EQUATION E_tCO2_ETS_pj_notNatgas[em,es,e,i,t];
E_tCO2_ETS_pj_notNatgas[em,es,e,i,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1tco2_ets_e[em,es,e,i,t] and not natgas[e])) and tco2_ets_pj_exists_dummy[em,es,e,i,t])..  
            tCO2_ETS_pj[em,es,e,i,t]  =E=  tCO2_ETS[t]/10**6 * uEmmE_BU[em,es,e,i,t];
EQUATION E_tCO2_ETS_pj_NatgasBio[em,es,e,i,t];
E_tCO2_ETS_pj_NatgasBio[em,es,e,i,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1tco2_ets_e[em,es,e,i,t] and natgas[e] and co2bio[em])) and tco2_ets_pj_exists_dummy[em,es,e,i,t]).. 
