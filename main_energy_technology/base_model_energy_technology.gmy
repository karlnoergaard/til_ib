EQUATION E_vtBotded_i[i,t];
E_vtBotded_i[i,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1y_i[i,t])) and vtbotded_exists_dummy[i,t]).. 
        vtBotded[i,t]  =E=  sum((es,e), vtEmarg[es,e,i,t] - vtE_NAS[es,e,i,t]);
EQUATION E_vtEmmRxE_i[i,t];
E_vtEmmRxE_i[i,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1y_i[i,t])) and vtemmrxe_exists_dummy[i,t]).. 
        vtEmmRxE[i,t]  =E=   vtCO2_xE[i,t] + vtCO2_ETS_xE[i,t];
EQUATION E_jvtBotded_i[i,t];
E_jvtBotded_i[i,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1y_i[i,t])) and jvtbotded_exists_dummy[i,t]).. 
      jvtBotded[i,t]  =E=  vtBotded[i,t];
EQUATION E_jvtBotded_Hh[t];
E_jvtBotded_Hh[t]$(((t1.val <= t.val and t.val <= tend.val)) and jvtbotded_hh_exists_dummy[t]).. 
      jvtBotded_Hh[t]  =E=  sum((es,e,c), vtEmarg[es,e,c,t] - vtE_NAS[es,e,c,t]);
EQUATION E_jvtEmmRxE_i[i,t];
E_jvtEmmRxE_i[i,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1y_i[i,t])) and jvtemmrxe_exists_dummy[i,t]).. 
      jvtEmmRxE[i,t]  =E=  vtEmmRxE[i,t];
EQUATION E_jvtCO2_ETS_tot[t];
E_jvtCO2_ETS_tot[t]$(((t1.val <= t.val and t.val <= tend.val)) and jvtco2_ets_tot_exists_dummy[t]).. 
      jvtCO2_ETS_tot[t]  =E=  sum(d, vtCO2_ETS[d,t] + vtCO2_ETS2[d,t]);
EQUATION E_tY_i_tax_i[i,t];
E_tY_i_tax_i[i,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1y_i[i,t])) and ty_i_tax_exists_dummy[i,t]).. 
      vtY_i_tax[i,t]  =E=  tY_i_tax_xETS[i,t] * qY_i[i,t] + vtCO2_ETS[i,t] + vtCO2_ETS2[i,t];
EQUATION E_jvtCO2_ETS2_Hh[t];
E_jvtCO2_ETS2_Hh[t]$(((t1.val <= t.val and t.val <= tend.val)) and jvtco2_ets2_hh_exists_dummy[t]).. 
      jvtCO2_ETS2_Hh[t]  =E=  sum(c, vtCO2_ETS2[c,t]);
EQUATION E_jvtCO2_xE_i[i,t];
E_jvtCO2_xE_i[i,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1tco2_xe[i,t])) and jvtco2_xe_exists_dummy[i,t]).. 
      jvtCO2_xE[i,t]  =E=  vtCO2_xE[i,t];
EQUATION E_vtE_duty_tot_d[d,t];
E_vtE_duty_tot_d[d,t]$(((t1.val <= t.val and t.val <= tend.val)) and vte_duty_tot_exists_dummy[d,t])..     vtE_duty_tot[d,t]  =E=  sum((etaxes,es,e), vtE_duty[etaxes,es,e,d,t]);
