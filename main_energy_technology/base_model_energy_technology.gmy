E_pY2pM_i_d[i,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and py2pm_i_d_exists_dummy[i,d,t])..  pY2pM_i_d[i,d,t]  =E=  pY_i_d[i,d,t] / pM_i_d[i,d,t];
EQUATION E_rM_i_d[i,d,t];
E_rM_i_d[i,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1y_i_d[i,d,t] and d1m_i_d[i,d,t])) and rm_exists_dummy[i,d,t]).. 
    qM_i_d[i,d,t] * (1-rM0[i,d,t])  =E=  qY_i_d[i,d,t] * rM0[i,d,t] * pY2pM_i_d[i,d,t] **eM_i_d[i,d];

# ----- gamY: Initialize imports_equations model -----
