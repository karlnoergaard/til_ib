EQUATION E_pX2pRoW_x[x,t];
E_pX2pRoW_x[x,t]$(((t1.val <= t.val and t.val <= tend.val)) and px2prow_x_exists_dummy[x,t])..  pX2pRoW_x[x,t]  =E=  pD[x,t] / pRoW_x[x,t];

