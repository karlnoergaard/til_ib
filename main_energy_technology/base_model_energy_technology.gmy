# ----- gamY: Initialize energy_margins equation block -----

# ----- gamY: Initialize energy_margins_endogenous group -----
EQUATION E_vE_margins_es_e_d_i[es,e,d,i,t];
E_vE_margins_es_e_d_i[es,e,d,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and ve_margins_exists_dummy[es,e,d,i,t])..  vE_margins[es,e,d,i,t]  =E=   pE_margins[es,e,d,i,t] * qEpj[es,e,d,t];
EQUATION E_pE_margins_es_e_d_i[es,e,d,i,t];
E_pE_margins_es_e_d_i[es,e,d,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and pe_margins_exists_dummy[es,e,d,i,t])..  pE_margins[es,e,d,i,t]  =E=  fpE_margins[es,e,d,i,t] * pY_CET['out_other',i,t]/pY_CET['out_other',i,tBase];
EQUATION E_vD_E_margins_i[i,t];
E_vD_E_margins_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and vd_e_margins_exists_dummy[i,t])..  vD_E_margins[i,t]  =E=  sum((es,e,d), vE_margins[es,e,d,i,t]);
EQUATION E_qD_E_margins_i[i,t];
E_qD_E_margins_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qd_e_margins_exists_dummy[i,t]).. 
					vD_E_margins[i,t]  =E=  pD_E_margins[i,t] * qD_E_margins[i,t];
EQUATION E_pD_E_margins_i[i,t];
E_pD_E_margins_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and pd_e_margins_exists_dummy[i,t])..  pD_E_margins[i,t]  =E=  pY_CET['out_other',i,t];
EQUATION E_vOtherDistributionProfits_E_margins_i[i,t];
E_vOtherDistributionProfits_E_margins_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and votherdistributionprofits_e_margins_exists_dummy[i,t])..  vOtherDistributionProfits_E_margins[i,t]  =E=  vD_E_margins[i,t] - pY_CET['out_other',i,t] * qD_E_margins[i,t];

# ----- gamY: Initialize energy_margins model -----
MODEL energy_margins / 
E_vE_margins_es_e_d_i, E_pE_margins_es_e_d_i, E_vD_E_margins_i, E_qD_E_margins_i, E_pD_E_margins_i, E_vOtherDistributionProfits_E_margins_i
 /;

		
# ----- gamY: Initialize energy_markets_IO_link equation block -----

# ----- gamY: Initialize energy_markets_IO_link_endogenous group -----
EQUATION E_sSupply_e_i_y_e_i[e,i,t];
E_sSupply_e_i_y_e_i[e,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and ssupply_e_i_y_exists_dummy[e,i,t]).. sSupply_e_i_y[e,i,t]  =E=  vY_CET[e,i,t]/sum(i_a, vY_CET[e,i_a,t] + vM_CET[e,i_a,t]);
EQUATION E_jfpY_i_d_not_energymargins[i,d,t];
E_jfpY_i_d_not_energymargins[i,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1y_i_d[i,d,t] and not i_energymargins[i] and d_ene[d])) and jfpy_i_d_exists_dummy[i,d,t]).. 
				vY_i_d_base[i,d,t]
					 =E=  sum((e,es,d_a)$es_d2d(es,d_a,d),  sSupply_d_e_i_adj[d,e,i,t] * vEpj_base[es,e,d_a,t]) + jvY_i_d_base[i,d,t];
EQUATION E_jfpY_i_d_energymargins[i,d,t];
E_jfpY_i_d_energymargins[i,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1y_i_d[i,d,t] and i_energymargins[i] and d_ene[d])) and jfpy_i_d_exists_dummy[i,d,t]).. 
				vY_i_d_base[i,d,t] 
 =E=  sum((e,es,d_a)$es_d2d(es,d_a,d), sSupply_d_e_i_adj[d,e,i,t] * vEpj_base[es,e,d_a,t])
					+ sum((e,es,d_a)$es_d2d(es,d_a,d), pE_margins[es,e,d_a,i,t] * qEpj[es,e,d_a,t]) + jvY_i_d_base[i,d,t];
EQUATION E_jfpM_i_d[i,d,t];
E_jfpM_i_d[i,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1m_i_d[i,d,t] and d_ene[d])) and jfpm_i_d_exists_dummy[i,d,t]).. 
				vM_i_d_base[i,d,t]
					 =E=  sum((e,es,d_a)$es_d2d(es,d_a,d), (1-sum(i_a,sSupply_d_e_i_adj[d,e,i_a,t])) * vEpj_base[es,e,d_a,t]) + jvM_i_d_base[i,d,t];
EQUATION E_rYM_i_d[i,d,t];
E_rYM_i_d[i,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1y_i_d[i,d,t] and not i_energymargins[i] and d_ene[d])) and rym_exists_dummy[i,d,t]).. 
				qY_i_d[i,d,t]*pY_i_d_base[i,d,t-1] =E=   sum((e,es,d_a)$es_d2d(es,d_a,d),  sSupply_d_e_i_adj[d,e,i,t] * pEpj_base[es,e,d_a,t-1] * qEpj[es,e,d_a,t])  + jqY_i_d[i,d,t];
EQUATION E_rYM_energymargins[i,d,t];
E_rYM_energymargins[i,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1y_i_d[i,d,t] and i_energymargins[i] and d_ene[d])) and rym_exists_dummy[i,d,t]).. 
		
				qY_i_d[i,d,t]*pY_i_d_base[i,d,t-1]   =E=  sum((e,es,d_a)$es_d2d(es,d_a,d), sSupply_d_e_i_adj[d,e,i,t] * pEpj_base[es,e,d_a,t-1] * qEpj[es,e,d_a,t])	
	+ sum((e,es,d_a)$es_d2d(es,d_a,d),  pE_margins[es,e,d_a,i,t-1] * qEpj[es,e,d_a,t]) + jqY_i_d[i,d,t];
EQUATION E_rM0_energy_imports[i,d,t];
E_rM0_energy_imports[i,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1m_i_d[i,d,t] and d1y_i_d[i,d,t] and d_ene[d])) and rm0_exists_dummy[i,d,t]).. 
				qM_i_d[i,d,t]*pM_i_d_base[i,d,t-1]   =E=  sum((e,es,d_a)$es_d2d(es,d_a,d), (1-sum(i_a, sSupply_d_e_i_adj[d,e,i_a,t])) *  pEpj_base[es,e,d_a,t-1] * qEpj[es,e,d_a,t]) + jqM_i_d[i,d,t];
EQUATION E_rYM_energy_imports[i,d,t];
E_rYM_energy_imports[i,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1m_i_d[i,d,t] and not d1y_i_d[i,d,t] and d_ene[d])) and rym_exists_dummy[i,d,t]).. 
				qM_i_d[i,d,t]*pM_i_d_base[i,d,t-1]   =E=  sum((e,es,d_a)$es_d2d(es,d_a,d), (1-sum(i_a, sSupply_d_e_i_adj[d,e,i_a,t])) *  pEpj_base[es,e,d_a,t-1] * qEpj[es,e,d_a,t]) + jqM_i_d[i,d,t];
EQUATION E_sSupply_d_e_i_adj_d_ene_e_i[d_ene,e,i,t];
E_sSupply_d_e_i_adj_d_ene_e_i[d_ene,e,i,t]$(((t1.val <= t.val and t.val <= tend.val) and (t.val>tdataend.val)) and ssupply_d_e_i_adj_exists_dummy[d_ene,e,i,t]).. 
					sSupply_d_e_i_adj[d_ene,e,i,t]  =E=  sSupply_d_e_i_adj[d_ene,e,i,tDataEnd] + adj_sSupply_d_e_i_adj[e,i,t];
EQUATION E_adj_sSupply_d_e_i_adj_e_i[e,i,t];
E_adj_sSupply_d_e_i_adj_e_i[e,i,t]$(((t1.val <= t.val and t.val <= tend.val) and (t.val>tdataend.val)) and adj_ssupply_d_e_i_adj_exists_dummy[e,i,t]).. 					
					sum(d, sum((es,d_a)$es_d2d(es,d_a,d), sSupply_d_e_i_adj[d,e,i,t] * vEpj_base[es,e,d_a,t]))  =E=  vY_CET[e,i,t] + j_adj_sSupply_d_e_i_adj[e,i]$(tDataEnd[t]);

# ----- gamY: Initialize energy_markets_IO_link model -----
MODEL energy_markets_IO_link / 
E_sSupply_e_i_y_e_i, E_jfpY_i_d_not_energymargins, E_jfpY_i_d_energymargins, E_jfpM_i_d, E_rYM_i_d, E_rYM_energymargins, E_rM0_energy_imports, E_rYM_energy_imports, E_sSupply_d_e_i_adj_d_ene_e_i, E_adj_sSupply_d_e_i_adj_e_i
 /; 

