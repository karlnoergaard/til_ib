E_vtE_vat_tot_d[d,t]$(((t1.val <= t.val and t.val <= tend.val)) and vte_vat_tot_exists_dummy[d,t])..     vtE_vat_tot[d,t]  =E=  sum((es,e), vtE_vat[es,e,d,t]);
EQUATION E_tY_i_d_not_energymargins[i,d,t];
E_tY_i_d_not_energymargins[i,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1y_i_d[i,d,t] and not i_energymargins[i] and d_ene[d])) and ty_i_d_exists_dummy[i,d,t]).. 
						vtY_i_d[i,d,t]
							 =E=    sum((e,es,d_a)$es_d2d(es,d_a,d),  sSupply_d_e_i_adj[d,e,i,t] * vte_NAS[es,e,d_a,t]) 
                  
                  + vtY_i_d_calib[i,d,t];
EQUATION E_tY_i_denergymargins[i,d,t];
E_tY_i_denergymargins[i,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1y_i_d[i,d,t] and i_energymargins[i] and d_ene[d])) and ty_i_d_exists_dummy[i,d,t]).. 
						vtY_i_d[i,d,t]
							 =E=  sum((e,es,d_a)$es_d2d(es,d_a,d),  sSupply_d_e_i_adj[d,e,i,t] * vte_NAS[es,e,d_a,t]) + vtY_i_d_calib[i,d,t];
EQUATION E_tM_i_d_not_energymargins[i,d,t];
E_tM_i_d_not_energymargins[i,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1m_i_d[i,d,t] and not i_energymargins[i] and d_ene[d])) and tm_i_d_exists_dummy[i,d,t]).. 
						vtM_i_d[i,d,t]
							 =E=    sum((e,es,d_a)$es_d2d(es,d_a,d),  (1-sum(i_a,sSupply_d_e_i_adj[d,e,i_a,t])) * vte_NAS[es,e,d_a,t]) 
                  
                  + vtM_i_d_calib[i,d,t];

