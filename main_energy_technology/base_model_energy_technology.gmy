# ------------------------------------------------------------------------------
# Energy Technology Choice Model
# ------------------------------------------------------------------------------
# This partial model implements the technology choice model for energy services
# using a smooth transition approach with log-normal distributions.

# ------------------------------------------------------------------------------
# 1. Variable and Dummy Definitions
# ------------------------------------------------------------------------------

# ----- gamY: IF "variables" == "variables": -----


# 1.1 Dummy Variables
# ----- gamY: Initialize SG_Energy_technology_dummies group -----
$offlisting
Set d1sqTPotential[l,es,d,t] "Dummy determining the existence of technology potentials" //;
Set d1pTK[d,t] "Dummy determining the existence of user costs for technologies" //;
Set d1uTE[l,es,e,d,t] "Dummy determining the existence of energy input in technology" //;
Set d1qES_e[es,e,d,t] "Dummy determining the existence of energy use (sum across technologies)" //;
Set d1qES[es,d,t] "Dummy determining the existence of energy service, quantity" //;
Set d1qI_k_i_energy_tech[k,i,t] "Dummy determining the existence of energy technology capital use" //;
$onlisting


parameter
  d1switch_energy_technology "Dummy to control whether the energy technology model is turned on (=1) or off (=0)"
  d1switch_integrate_energy_technology "Dummy to control whether the energy technology model is integrated with the CGE-model (=1) or not (=0)"
  jqESE_phaseout[t] "Parameter to phase out jqESE in the calibration model"
  smooth_factor "Parameter governing smoothing of total energy technology costs (pTPotential). This is used for calculating the technology-specific smoothing parameter eP."
;

# 1.2 Main Variables
$offlisting
Variable pTK[d,t] "User cost of capital in technologies for energy services" //;
SET pTK_exists_dummy[d,t];
Variable jpTK[d,t] "Share parameter linking capital user cost in energy technology model to CGE model" //;
SET jpTK_exists_dummy[d,t];
Variable qES[es,d,t] "Energy service, quantity." //;
SET qES_exists_dummy[es,d,t];
Variable jES[es,d,t] "Share parameter linking energy service in energy technology model to energy service demand in CGE model" //;
SET jES_exists_dummy[es,d,t];
Variable sqTPotential[l,es,d,t] "Potential supply by technology l in ratio of energy service (share of qES)" //;
SET sqTPotential_exists_dummy[l,es,d,t];
Variable theta[l,es,d,t] "jsk same sqTPotential. only used adhoc for loading data" //;
SET theta_exists_dummy[l,es,d,t];
Variable eP[l,es,d,t] "Parameter governing efficiency of costs of technology l (smoothing parameter)" //;
SET eP_exists_dummy[l,es,d,t];
Variable uTE[l,es,e,d,t] "Input of energy in technology l per PJ output at full potential" //;
SET uTE_exists_dummy[l,es,e,d,t];
Variable uTI[l,es,d,t] "Investment cost, billion EUR per PJ output at full potential" //;
SET uTI_exists_dummy[l,es,d,t];
Variable uTC[l,es,d,t] "Variable capital costs, billion EUR per PJ output at full potential" //;
SET uTC_exists_dummy[l,es,d,t];
Variable uTKexp[l,es,d,t] "Average input of machinery capital in technology l per PJ output at full potential" //;
SET uTKexp_exists_dummy[l,es,d,t];
Variable uTKmargNoBound[l,es,d,t] "Input of machinery capital in technology l per PJ output at the margin of supply - Unrestricted" //;
SET uTKmargNoBound_exists_dummy[l,es,d,t];
Variable uTKmarg[l,es,d,t] "Input of machinery capital in technology l per PJ output at the margin of supply - Lower bounded" //;
SET uTKmarg_exists_dummy[l,es,d,t];
Variable pTPotential[l,es,d,t] "Average price of technology l at full potential, ie. when sTSupply=sqTPotential" //;
SET pTPotential_exists_dummy[l,es,d,t];
Variable pT[l,es,d,t] "Average price of technology l at level of supply" //;
SET pT_exists_dummy[l,es,d,t];
Variable pESmarg[es,d,t] "Marginal price of energy services based on the supply by technologies" //;
SET pESmarg_exists_dummy[es,d,t];
Variable sqT[l,es,d,t] "Supply by technology l in ratio of energy service (share of qES)" //;
SET sqT_exists_dummy[l,es,d,t];
Variable vTSupply[l,es,d,t] "Value (or costs) of energy service supplied by technology l " //;
SET vTSupply_exists_dummy[l,es,d,t];
Variable vES[es,d,t] "Value of energy service" //;
SET vES_exists_dummy[es,d,t];
Variable pES[es,d,t] "Energy service, price." //;
SET pES_exists_dummy[es,d,t];
Variable vESK[es,d,t] "Value of machinery capital" //;
SET vESK_exists_dummy[es,d,t];
Variable qESE[es,e,d,t] "Quantity of energy in energy services" //;
SET qESE_exists_dummy[es,e,d,t];
Variable qESK[es,d,t] "Quantity of machinery capital in energy services" //;
SET qESK_exists_dummy[es,d,t];
Variable jqESE[es,e,i,t] "Share parameter linking energy input in the energy technology model to energy input in the CGE-model" //;
SET jqESE_exists_dummy[es,e,i,t];
Variable qI_k_i_energy_tech[k,i,t] "Quantity of investments from the energy technology model" //;
SET qI_k_i_energy_tech_exists_dummy[k,i,t];
Variable vI_k_i_energy_tech[k,i,t] "Value of investments from the energy technology model" //;
SET vI_k_i_energy_tech_exists_dummy[k,i,t];
Variable qEmmE_CCS[es,e,d,t] "Quantity of CCS in energy services" //;
SET qEmmE_CCS_exists_dummy[es,e,d,t];
Variable pK_k_i_baseline[k,i,t] "Baseline user cost of capital - for integration" //;
SET pK_k_i_baseline_exists_dummy[k,i,t];
Variable qK_k_i_baseline[k,i,t] "Baseline capital quantity - for integration" //;
SET qK_k_i_baseline_exists_dummy[k,i,t];
Variable pProd_baseline[pf,i,t] "Price in production tree (baseline) - for testing" //;
SET pProd_baseline_exists_dummy[pf,i,t];
Variable qProd_baseline[pf,i,t] "Quantity in production tree (baseline) - for testing" //;
SET qProd_baseline_exists_dummy[pf,i,t];
Variable vI_k_i_baseline[k,i,t] "Value of investments (baseline) - for testing" //;
SET vI_k_i_baseline_exists_dummy[k,i,t];
Variable qEtot_baseline[e,t] "Total quantity of energy use (baseline) - for testing" //;
SET qEtot_baseline_exists_dummy[e,t];
$onlisting


parameter
  LifeSpan[l,es,d,t] "Life span of technology l in years"
  DiscountRate[l,es,d] "Discount rate of technology l"
  ;


