EQUATION E_vtCO2_ETS_xE_i[i,t];
E_vtCO2_ETS_xE_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and vtco2_ets_xe_exists_dummy[i,t])..   vtCO2_ETS_xE[i,t]  =E=  tCO2_ETS[t]/10**6 * qEmmxE['CO2ubio',i,t];
EQUATION E_vtCO2_ETS_i[i,t];
