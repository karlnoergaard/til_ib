# ----- gamY: Initialize energy_and_emissions_taxes model -----
MODEL energy_and_emissions_taxes / 
E_qCO2e_BU_energy_Corp_es_e_i, E_qCO2e_BU_energy_Hh_es_e_c, E_qCO2e_d_energy_d, E_qCO2e_d_non_energy_i, E_qCO2e_taxgroup_CO2etax, E_vtE_duty_etaxes_es_e_d, E_vtE_vat_es_e_d, E_vtE_NAS_es_e_d, E_vtE_es_e_d, E_vtEmarg_es_e_d, E_tpE_marg_es_e_d, E_tqE_marg_es_e_d, E_tCO2_Emarg_pj_notNatgas, E_tCO2_Emarg_pj_NatgasBio, E_tCO2_Emarg_pj_NatgasuBio, E_tEmarg_duty_etaxes_es_e_d, E_vtCO2_xE_d, E_tCO2_ETS_pj_notNatgas, E_tCO2_ETS_pj_NatgasBio, E_tCO2_ETS_pj_NatgasuBio, E_vtCO2_ETS_E_i, E_vtCO2_ETS_xE_i, E_vtCO2_ETS_i, E_tCO2_ETS2_pj_notNatgas, E_tCO2_ETS2_pj_NatgasBio, E_tCO2_ETS2_pj_NatgasuBio, E_vtCO2_ETS2_E_d, E_vtCO2_ETS2_d
 /;           

  
# ----- gamY: Initialize energy_and_emissions_taxes_links equation block -----

