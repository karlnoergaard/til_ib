$ONEOLCOM
$EOLCOM #


# First the base model is included and executed

# ----- gamY: Import file: c:\greu_ib\GREU\model\base_model.gms ----- 
$onMulti # Allows adding to an already defined set or model with multiple "model" or "set" statements

# =============================================================================
# IMPORTS and initialization
# =============================================================================

# ----- gamY: Import file: c:\greu_ib\GREU\model\settings.gms ----- 

OPTION
  SYSOUT=OFF
  SOLPRINT=OFF
  LIMROW=0
  LIMCOL=0
  DECIMALS=6
  PROFILE = 1
  PROFILETOL = 0.01

  CNS=CONOPT4  # Choose solver
;

;
;
;

;
 #Can be used to set supply prices as exogeonus
 #Can be used to switch between generic dummy data (=1) and excel-based data (=0)

parameter gp "Steady state rate of inflation." /0.02/;
parameter gq "Steady state labor saving technical progress." /0.01/;

parameter epsilon "Small number to avoid singularities" /1e-7/;

# ======================================================================================================================
# Solver options
# ======================================================================================================================
$ONECHO > conopt4.opt
  # See https://www.gams.com/latest/docs/S_CONOPT4.html
  # for available solver options

  #  Keep searching for a solution even if a bound is hit (due to non linearities)
  lmmxsf = 1

  #Optimality tolerance for reduced gradient
  # RTREDG = 1.e-6

  # Mtd_Step_Phase0 = 0

  # Limit on number of error messages related to infeasible pre-triangle
  # 25 is default but often not enough. 
  Lim_Pre_Msg = 400
$OFFECHO

