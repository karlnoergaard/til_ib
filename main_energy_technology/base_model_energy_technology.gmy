E_qI_k_i_energy_tech_k_i[k,i,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology and d1switch_integrate_energy_technology)) and qi_k_i_energy_tech_exists_dummy[k,i,t])..  qI_k_i_energy_tech[k,i,t]  =E=  sum(es$(es2k[es,k]), qESK[es,i,t]);
