E_qEmmE_CCS_es_e_d[es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology and d1switch_integrate_energy_technology)) and qemme_ccs_exists_dummy[es,e,d,t])..  qEmmE_CCS[es,e,d,t]  =E=  qESE[es,e,d,t];

