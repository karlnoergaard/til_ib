E_vX[t]$(((t1.val <= t.val and t.val <= tend.val)) and vx_exists_dummy[t])..  vX[t]  =E=  sum(x, vD[x,t]);
EQUATION E_pR[t];
E_pR[t]$(((t1.val <= t.val and t.val <= tend.val)) and pr_exists_dummy[t])..  pR[t] * qR[t]  =E=  vR[t];
EQUATION E_pE[t];
E_pE[t]$(((t1.val <= t.val and t.val <= tend.val)) and pe_exists_dummy[t])..  pE[t] * qE[t]  =E=  vE[t];
EQUATION E_pI[t];
E_pI[t]$(((t1.val <= t.val and t.val <= tend.val)) and pi_exists_dummy[t])..  pI[t] * qI[t]  =E=  vI[t];
EQUATION E_pC[t];
E_pC[t]$(((t1.val <= t.val and t.val <= tend.val)) and pc_exists_dummy[t])..  pC[t] * qC[t]  =E=  vC[t];
EQUATION E_pG[t];
E_pG[t]$(((t1.val <= t.val and t.val <= tend.val)) and pg_exists_dummy[t])..  pG[t] * qG[t]  =E=  vG[t];
EQUATION E_pX[t];
E_pX[t]$(((t1.val <= t.val and t.val <= tend.val)) and px_exists_dummy[t])..  pX[t] * qX[t]  =E=  vX[t];
EQUATION E_qR[t];
E_qR[t]$(((t1.val <= t.val and t.val <= tend.val)) and qr_exists_dummy[t])..  qR[t] * pR[t-1]  =E=  sum(rx, pD[rx,t-1] * qD[rx,t]);
EQUATION E_qE[t];
E_qE[t]$(((t1.val <= t.val and t.val <= tend.val)) and qe_exists_dummy[t])..  qE[t] * pE[t-1]  =E=  sum(re, pD[re,t-1] * qD[re,t]);
EQUATION E_qI[t];
E_qI[t]$(((t1.val <= t.val and t.val <= tend.val)) and qi_exists_dummy[t])..  qI[t] * pI[t-1]  =E=  sum(k,  pD[k,t-1]  * qD[k,t]) + pD['invt',t-1] * qD['invt',t] + pD['invt_ene',t-1]*qD['invt_ene',t];
EQUATION E_qC[t];
E_qC[t]$(((t1.val <= t.val and t.val <= tend.val)) and qc_exists_dummy[t])..  qC[t] * pC[t-1]  =E=  sum(c,  pD[c,t-1]  * qD[c,t]);
EQUATION E_qG[t];
E_qG[t]$(((t1.val <= t.val and t.val <= tend.val)) and qg_exists_dummy[t])..  qG[t] * pG[t-1]  =E=  sum(g,  pD[g,t-1]  * qD[g,t]);
EQUATION E_qX[t];
E_qX[t]$(((t1.val <= t.val and t.val <= tend.val)) and qx_exists_dummy[t])..  qX[t] * pX[t-1]  =E=  sum(x,  pD[x,t-1]  * qD[x,t]);
EQUATION E_vY_i[i,t];
E_vY_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and vy_i_exists_dummy[i,t])..  vY_i[i,t] + vtY_i[i,t]  =E=  sum(d, vY_i_d[i,d,t]);
EQUATION E_vY[t];
