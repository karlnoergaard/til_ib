# ----- gamY: Initialize template_equations equation block -----

# ----- gamY: Initialize template_endogenous group -----
EQUATION E_submodel_template_test_variable[t];
E_submodel_template_test_variable[t]$(((t1.val <= t.val and t.val <= tend.val)) and submodel_template_test_variable_exists_dummy[t])..  submodel_template_test_variable[t]  =E=  1;

# ----- gamY: Initialize template_equations model -----
MODEL template_equations / 
E_submodel_template_test_variable
 /;

# Add equation and endogenous variables to main model
model main / template_equations /;



