# ----- gamY: Initialize consumption_disaggregated_equations equation block -----

# ----- gamY: Initialize consumption_disaggregated_endogenous group -----
EQUATION E_pCHh_cf_bottom[cf_bottom,t];
E_pCHh_cf_bottom[cf_bottom,t]$(((t1.val <= t.val and t.val <= tend.val)) and pchh_exists_dummy[cf_bottom,t]).. 
    pCHh[cf_bottom,t]  =E=  sum(c $c2cf_bottom_mapping[c,cf_bottom], pD[c,t]) + jpCHh[cf_bottom,t];
EQUATION E_qCHh_cf_top[cf,t];
E_qCHh_cf_top[cf,t]$(((t1.val <= t.val and t.val <= tend.val) and (cf_top[cf] and not t1[t])) and qchh_exists_dummy[cf,t])..  qCHh[cf,t] * pCHh[cf,t] - jvtBotded_Hh[t]  =E=  vC[t];
EQUATION E_jD_c[c,t];
E_jD_c[c,t]$(((t1.val <= t.val and t.val <= tend.val) and (not t1[t])) and jd_c_exists_dummy[c,t])..  qD[c,t]  =E=  sum(cf_bottom $c2cf_bottom_mapping[c,cf_bottom], qCHh[cf_bottom,t]);
EQUATION E_qCHh_cf[cf,t];
E_qCHh_cf[cf,t]$(((t1.val <= t.val and t.val <= tend.val) and (not cf_top[cf])) and qchh_exists_dummy[cf,t]).. 
    qCHh[cf,t]  =E=  uCHh[cf,t]
                    * sum(cf_mapping[cfNest,cf],
                        pCHh2pNest[cf,cfNest,t]**(-eCHh[cfNest]) * qCHh[cfNest,t]
                    );
EQUATION E_pCHh_cfNest[cfnest,t];
E_pCHh_cfNest[cfnest,t]$(((t1.val <= t.val and t.val <= tend.val)) and pchh_exists_dummy[cfnest,t])..  pCHh[cfNest,t] * qCHh[cfNest,t]  =E=  sum(cf_mapping[cfNest,cf], pCHh[cf,t] * qCHh[cf,t]);
EQUATION E_pCHh2pNest_cf_cfNest[cf,cfnest,t];
E_pCHh2pNest_cf_cfNest[cf,cfnest,t]$(((t1.val <= t.val and t.val <= tend.val) and (cf_mapping[cfnest,cf])) and pchh2pnest_exists_dummy[cf,cfnest,t]).. 
   pCHh2pNest[cf,cfNest,t] * pCHh[cfNest,t]  =E=  pCHh[cf,t];

# ----- gamY: Initialize consumption_disaggregated_equations model -----
MODEL consumption_disaggregated_equations / 
E_pCHh_cf_bottom, E_qCHh_cf_top, E_jD_c, E_qCHh_cf, E_pCHh_cfNest, E_pCHh2pNest_cf_cfNest
 /;

# Add equation and endogenous variables to main model
model main / consumption_disaggregated_equations /;



