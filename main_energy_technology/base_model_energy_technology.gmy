EQUATION E_tCO2_ETS_pj_NatgasuBio[em,es,e,i,t];
E_tCO2_ETS_pj_NatgasuBio[em,es,e,i,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1tco2_ets_e[em,es,e,i,t] and natgas[e] and co2ubio[em])) and tco2_ets_pj_exists_dummy[em,es,e,i,t]).. 
