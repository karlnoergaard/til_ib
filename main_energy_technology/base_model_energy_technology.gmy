EQUATION E_qK_k_i[k,i,t];
E_qK_k_i[k,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qk_k_i_exists_dummy[k,i,t])..  qK_k_i[k,i,t]  =E=  qK2qY_k_i[k,i,t] * qY_i[i,t];
EQUATION E_qL_i[i,t];
E_qL_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and ql_i_exists_dummy[i,t])..  qL_i[i,t]  =E=  qL2qY_i[i,t] * qY_i[i,t];
EQUATION E_qD_i[i,t];
E_qD_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qd_exists_dummy[i,t])..  qD[i,t]  =E=  qR2qY_i[i,t] * qY_i[i,t];
EQUATION E_qInvt_i[i,t];
E_qInvt_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qinvt_i_exists_dummy[i,t])..  qInvt_i[i,t]  =E=  qInvt2qY_i[i,t] * qY_i[i,t];
EQUATION E_qD_invt[invt,t];
E_qD_invt[invt,t]$(((t1.val <= t.val and t.val <= tend.val)) and qd_exists_dummy[invt,t])..  qD[invt,t]  =E=  sum(i, qInvt_i[i,t]);
EQUATION E_vInvt_i[i,t];
E_vInvt_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and vinvt_i_exists_dummy[i,t])..  vInvt_i[i,t]  =E=  pD['invt',t] * qInvt_i[i,t];
EQUATION E_qI_k_i[k,i,t];
E_qI_k_i[k,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qi_k_i_exists_dummy[k,i,t])..  qI_k_i[k,i,t]  =E=  qK_k_i[k,i,t] - (1-rKDepr_k_i[k,i,t]) * qK_k_i[k,i,t-1]/fq - jI_k_i[k,i]$(tDataEnd[t])
                      + qI_k_i_energy_tech[k,i,t];
EQUATION E_qD_k[k,t];
E_qD_k[k,t]$(((t1.val <= t.val and t.val <= tend.val)) and qd_exists_dummy[k,t])..  qD[k,t]  =E=  sum(i, qI_k_i[k,i,t]);
