E_vY_CET_out_other_i[out_other,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and vy_cet_exists_dummy[out_other,i,t])..  vY_CET[out_other,i,t]  =E=  pY_CET[out_other,i,t]*qY_CET[out_other,i,t];
