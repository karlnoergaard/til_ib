#        (process_normal,process_special,in_ETS) . machine_energy 
#        /;

#£Temp until IO-split       
set es2re(es,re)
     /
       heating . energy
       transport . energy
       (process_normal,process_special,in_ETS) . energy 
       /;

set es_d2d(es,d_a,d)/
     (heating,appliances) . cHouEne . cHouEne
     transport . cCarEne . cCarEne
     set.es . set.i . energy
     set.es . xEne . xEne 
     set.es . invt_ene . invt_ene
     /;


