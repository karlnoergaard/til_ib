E_pM_i_d_base_i_d[i,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and pm_i_d_base_exists_dummy[i,d,t])..  pM_i_d_base[i,d,t]  =E=  (1+jfpM_i_d[i,d,t])/ (1+tM_i_d[i,d,tBase]) * pM_i[i,t];
EQUATION E_qY_i_d[i,d,t];
E_qY_i_d[i,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and qy_i_d_exists_dummy[i,d,t])..  qY_i_d[i,d,t]  =E=  (1-rM[i,d,t]) * rYM[i,d,t] * qD[d,t];
