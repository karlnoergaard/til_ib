E_adj_jfpY_i_d_i[i,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1y_i_nepnei[i,t] and not i_energymargins[i] and t.val>tdataend.val)) and adj_jfpy_i_d_exists_dummy[i,t]).. 
							sum(d_non_ene, pY_i_d_base[i,d_non_ene,t] * qY_i_d[i,d_non_ene,t])  =E=  vY_CET['out_other',i,t];
