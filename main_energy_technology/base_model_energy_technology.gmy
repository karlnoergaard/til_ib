E_rInterests_s_sector[sector,t]$(((t1.val <= t.val and t.val <= tend.val)) and rinterests_s_exists_dummy[sector,t])..  rInterests_s[sector,t]  =E=  rInterests[t] + jrInterests_s[sector,t];
EQUATION E_rHh[t];
E_rHh[t]$(((t1.val <= t.val and t.val <= tend.val)) and rhh_exists_dummy[t])..  rHh[t]*vNetFinAssets['Hh',t-1]/fv  =E=  (vNetInterests['Hh',t] + vNetDividends['Hh',t]);
EQUATION E_jrInterests_s_RoW[row,t];
E_jrInterests_s_RoW[row,t]$(((t1.val <= t.val and t.val <= tend.val)) and jrinterests_s_exists_dummy[row,t])..  sum(sector, vNetInterests[sector,t])  =E=  0;

# ----- gamY: Initialize financial_equations model -----
MODEL financial_equations / 
E_vI_private_nonfin, E_vI_private_fin, E_vI_private, E_vI_public, E_vNetFinAssets_Hh, E_vNetFinAssets_NonFinCorp, E_vNetFinAssets_FinCorp, E_vNetFinAssets_Gov, E_vNetFinAssets_RoW, E_vEBITDA_i, E_vNetEquity_Gov, E_vNetEquity_Hh, E_vNetEquity_FinCorp, E_vNetEquity_NonFinCorp, E_vNetEquity_RoW, E_vNetDebtInstruments_sector, E_rDividends, E_vNetDividends_sector, E_vNetInterests_sector, E_vNetRevaluations_sector, E_rInterests_s_sector, E_rHh, E_jrInterests_s_RoW
 /;

