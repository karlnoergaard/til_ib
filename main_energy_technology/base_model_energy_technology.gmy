E_uEpj_es_e_i[es,e,i,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology and d1switch_integrate_energy_technology) and (d1pepj_marg[es,e,i,t] and d1qes[es,i,t])) and uepj_exists_dummy[es,e,i,t])..  
