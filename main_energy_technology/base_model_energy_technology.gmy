		d1E_margins[es,e,d,i,'2019'] = d1E_margins[es,e,d,i,'2020'];
		d1E_margins_i[i,t] = yes$(sum(es,sum(d,sum(e,d1E_margins[es,e,d,i,t])))); 


	
