# ----- gamY: Initialize energy_technology_equations_output equation block -----

# ----- gamY: Initialize energy_technology_endogenous_output group -----
EQUATION E_qESE_es_e_d[es,e,d,t];
E_qESE_es_e_d[es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology)) and qese_exists_dummy[es,e,d,t])..  qESE[es,e,d,t]  =E=  
        
            qES[es,d,t] * sum(l$(d1sqTPotential[l,es,d,t]), sqT[l,es,d,t] * uTE[l,es,e,d,t]);
EQUATION E_qESK_es_d[es,d,t];
E_qESK_es_d[es,d,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology)) and qesk_exists_dummy[es,d,t])..  qESK[es,d,t]  =E=  
    qES[es,d,t] * 
    sum(l$(d1sqTPotential[l,es,d,t]),
        sqTPotential[l,es,d,t]*(uTKexp[l,es,d,t] * errorf((log(((uTKmarg[l,es,d,t]/uTKexp[l,es,d,t])**2)**0.5) - 0.5*eP[l,es,d,t]**2)/eP[l,es,d,t])) 
);
EQUATION E_vES_es_d[es,d,t];
E_vES_es_d[es,d,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology)) and ves_exists_dummy[es,d,t])..  vES[es,d,t]  =E=  
    sum(e, qESE[es,e,d,t]*pEpj_marg[es,e,d,t]) + qESK[es,d,t]*pTK[d,t];
EQUATION E_pES_es_d[es,d,t];
E_pES_es_d[es,d,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology)) and pes_exists_dummy[es,d,t])..  pES[es,d,t]  =E=  vES[es,d,t] / qES[es,d,t];
EQUATION E_vESK_es_d[es,d,t];
E_vESK_es_d[es,d,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology)) and vesk_exists_dummy[es,d,t])..  vESK[es,d,t]  =E=  qESK[es,d,t]*pTK[d,t];

