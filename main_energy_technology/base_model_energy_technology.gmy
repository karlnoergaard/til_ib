# ----- gamY: Initialize government_equations equation block -----

# ----- gamY: Initialize government_endogenous group -----
EQUATION E_vGovPrimaryBalance[t];
E_vGovPrimaryBalance[t]$(((t1.val <= t.val and t.val <= tend.val)) and vgovprimarybalance_exists_dummy[t])..  vGovPrimaryBalance[t]  =E=  vGovRevenue[t] - vGovExpenditure[t];
EQUATION E_vGovRevenue[t];
E_vGovRevenue[t]$(((t1.val <= t.val and t.val <= tend.val)) and vgovrevenue_exists_dummy[t])..  vGovRevenue[t]  =E=      + vtIndirect[t]
                            + vtDirect[t]
                            + vGovRevOther[t]
                            ;
EQUATION E_vtIndirect[t];
E_vtIndirect[t]$(((t1.val <= t.val and t.val <= tend.val)) and vtindirect_exists_dummy[t])..  vtIndirect[t]  =E=     vtY[t] + vtM[t] 
                        + vtY_Tax[t]  - jvtCO2_ETS_tot[t] 
                        + jvtCO2_ETS2_Hh[t] 
                        + sum(i, jvtCO2_xE[i,t])
                        + sum(i, vtIndirect_other[i,t])
                        ;
EQUATION E_vtIndirect_other_i[i,t];
E_vtIndirect_other_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and vtindirect_other_exists_dummy[i,t])..  vtIndirect_other[i,t]  =E=  sIndirect_other[t] * vGVA_i[i,t];
EQUATION E_vtDirect[t];
E_vtDirect[t]$(((t1.val <= t.val and t.val <= tend.val)) and vtdirect_exists_dummy[t])..  vtDirect[t]  =E=  vtHhReturn[t] + vtHhWages[t] + vtCorp[t] + vtDirect_other[t];
EQUATION E_vtHhReturn[t];
E_vtHhReturn[t]$(((t1.val <= t.val and t.val <= tend.val)) and vthhreturn_exists_dummy[t])..  vtHhReturn[t]  =E=  trHh[t] * rHh[t] * vNetFinAssets['Hh',t-1]/fv;
EQUATION E_vtHhWages[t];
E_vtHhWages[t]$(((t1.val <= t.val and t.val <= tend.val)) and vthhwages_exists_dummy[t])..  vtHhWages[t]  =E=  tW[t] * vWages[t];
EQUATION E_vtCorp[t];
E_vtCorp[t]$(((t1.val <= t.val and t.val <= tend.val)) and vtcorp_exists_dummy[t])..  vtCorp[t]  =E=  tCorp[t] * sum(i, vEBITDA_i[i,t]-vDepr_i[i,t]);
EQUATION E_vtDirect_other[t];
E_vtDirect_other[t]$(((t1.val <= t.val and t.val <= tend.val)) and vtdirect_other_exists_dummy[t])..  vtDirect_other[t]  =E=  sDirect_other[t] * (vtHhReturn[t] + vtHhWages[t]);
EQUATION E_vGovRevOther[t];
E_vGovRevOther[t]$(((t1.val <= t.val and t.val <= tend.val)) and vgovrevother_exists_dummy[t])..  vGovRevOther[t]  =E=  
                            + vGovRevGovCorp[t]
                            + vGovDepr[t]
                            + vCont[t]
                            + vGovReceiveCorp[t]
                            + vGovReceiveCorpNonCap[t]
                            + vGovReceiveF[t]
                            + vtCap[t]
                            ;
EQUATION E_vCont[t];
E_vCont[t]$(((t1.val <= t.val and t.val <= tend.val)) and vcont_exists_dummy[t])..  vCont[t]  =E=  pW[t] * vContExo[t];
EQUATION E_vGovRevGovCorp[t];
E_vGovRevGovCorp[t]$(((t1.val <= t.val and t.val <= tend.val)) and vgovrevgovcorp_exists_dummy[t]).. vGovRevGovCorp[t]  =E=  sum(i$i_public[i], vEBITDA_i[i,t]-vDepr_i[i,t]) + vGovRevGovCorpCorrection[t];
EQUATION E_vGovDepr[t];
E_vGovDepr[t]$(((t1.val <= t.val and t.val <= tend.val)) and vgovdepr_exists_dummy[t]).. vGovDepr[t]  =E=  sum(i$i_public[i], vDepr_i[i,t]) + vGovDeprCorrection[t];
EQUATION E_vGovReceiveCorp[t];
E_vGovReceiveCorp[t]$(((t1.val <= t.val and t.val <= tend.val)) and vgovreceivecorp_exists_dummy[t]).. vGovReceiveCorp[t]  =E=  sGovReceiveCorp[t] * sum(i, vGVA_i[i,t]);
EQUATION E_vGovReceiveCorpNonCap[t];
E_vGovReceiveCorpNonCap[t]$(((t1.val <= t.val and t.val <= tend.val)) and vgovreceivecorpnoncap_exists_dummy[t]).. vGovReceiveCorpNonCap[t]  =E=  sGovReceiveCorpNonCap[t] * sum(i, vGVA_i[i,t]);
EQUATION E_vtCap[t];
E_vtCap[t]$(((t1.val <= t.val and t.val <= tend.val)) and vtcap_exists_dummy[t]).. vtCap[t]  =E=  tCap[t] * vNetFinAssets['Hh',t];
EQUATION E_vGovExpenditure[t];
E_vGovExpenditure[t]$(((t1.val <= t.val and t.val <= tend.val)) and vgovexpenditure_exists_dummy[t])..  vGovExpenditure[t]  =E=  vG[t] + vHhTransfers[t] + vI_public[t]
                            + vGovExpOther[t] + vLumpsum[t];
EQUATION E_rG_g[g,t];
E_rG_g[g,t]$(((t1.val <= t.val and t.val <= tend.val) and (first(g))) and rg_g_exists_dummy[g,t])..  vG[t]  =E=  vG2vGDP[t] * vGDP[t];
EQUATION E_qD_g[g,t];
E_qD_g[g,t]$(((t1.val <= t.val and t.val <= tend.val)) and qd_exists_dummy[g,t])..  vD[g,t]  =E=  rG_g[g,t] * vG[t];
EQUATION E_vHhTransfers[t];
E_vHhTransfers[t]$(((t1.val <= t.val and t.val <= tend.val)) and vhhtransfers_exists_dummy[t])..  vHhTransfers[t]  =E=  pW[t] * qPopTransfers[t];
EQUATION E_vGovExpOther[t];
E_vGovExpOther[t]$(((t1.val <= t.val and t.val <= tend.val)) and vgovexpother_exists_dummy[t])..  vGovExpOther[t]  =E=  vGovSub[t] + vGov2Corp[t] + vGov2Foreign[t] + vGovNetAcquisitions[t];
EQUATION E_vGovSub[t];
E_vGovSub[t]$(((t1.val <= t.val and t.val <= tend.val)) and vgovsub_exists_dummy[t])..  vGovSub[t]  =E=  vtY_Sub[t] + sGovSub_Residual[t] * sum(i,vGVA_i[i,t]);
EQUATION E_vGov2Corp[t];
E_vGov2Corp[t]$(((t1.val <= t.val and t.val <= tend.val)) and vgov2corp_exists_dummy[t])..  vGov2Corp[t]  =E=  sGov2Corp[t] * sum(i, vGVA_i[i,t]);
EQUATION E_vNetGov2Corp_xIO_i[i,t];
E_vNetGov2Corp_xIO_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and vnetgov2corp_xio_exists_dummy[i,t])..  vNetGov2Corp_xIO[i,t]  =E=  (sGov2Corp[t] + sGovSub_Residual[t] - sGovReceiveCorp[t] - sGovReceiveCorpNonCap[t]) 
                                * vGVA_i[i,t]
                              - jvtCO2_xE[i,t] 
                              - vtIndirect_other[i,t] 
                              - tCorp[t] * (vEBITDA_i[i,t]-vDepr_i[i,t]);
EQUATION E_vNetHh2Gov[t];
E_vNetHh2Gov[t]$(((t1.val <= t.val and t.val <= tend.val)) and vnethh2gov_exists_dummy[t])..  vNetHh2Gov[t]  =E=  vtHhWages[t] + vtHhReturn[t] + vtDirect_other[t] 
                       + vCont[t] + vGovRevGovCorpCorrection[t] + vGovDeprCorrection[t] + vtCap[t] + jvtCO2_ETS2_Hh[t]
                       - vHhTransfers[t] - vGovNetAcquisitions[t] - vLumpsum[t];
EQUATION E_vNetGov2Foreign[t];
E_vNetGov2Foreign[t]$(((t1.val <= t.val and t.val <= tend.val)) and vnetgov2foreign_exists_dummy[t])..  vNetGov2Foreign[t]  =E=  vGov2Foreign[t] + jvtCO2_ETS_tot[t] - vGovReceiveF[t];

# ----- gamY: Initialize government_equations model -----
MODEL government_equations / 
E_vGovPrimaryBalance, E_vGovRevenue, E_vtIndirect, E_vtIndirect_other_i, E_vtDirect, E_vtHhReturn, E_vtHhWages, E_vtCorp, E_vtDirect_other, E_vGovRevOther, E_vCont, E_vGovRevGovCorp, E_vGovDepr, E_vGovReceiveCorp, E_vGovReceiveCorpNonCap, E_vtCap, E_vGovExpenditure, E_rG_g, E_qD_g, E_vHhTransfers, E_vGovExpOther, E_vGovSub, E_vGov2Corp, E_vNetGov2Corp_xIO_i, E_vNetHh2Gov, E_vNetGov2Foreign
 /;

# Add equation and endogenous variables to main model
model main / government_equations /;



