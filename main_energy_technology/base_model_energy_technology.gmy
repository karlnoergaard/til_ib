# ----- gamY: IF "equations" == "equations": -----



# ----- gamY: Initialize energy_technology_LCOE_equations equation block -----

# ----- gamY: Initialize energy_technology_LCOE_endogenous group -----
EQUATION E_uTKexp_l_es_d[l,es,d,t];
E_uTKexp_l_es_d[l,es,d,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology) and (t.val <= tend.val-lifespan[l,es,d,t]+1 and d1sqtpotential[l,es,d,t])) and utkexp_exists_dummy[l,es,d,t])..  
    uTKexp[l,es,d,t]  =E= 
     (uTI[l,es,d,t] 
      + sum(tt$(tt.val >= t.val and tt.val <= tend.val and tt.val < t.val+LifeSpan[l,es,d,t] and d1sqTPotential[l,es,d,tt]), 
      uTC[l,es,d,tt] / ((1+DiscountRate[l,es,d])**(tt.val-t.val)))
) 
        / sum(tt$(tt.val >= t.val and tt.val <= tend.val and tt.val < t.val+LifeSpan[l,es,d,t] and d1sqTPotential[l,es,d,tt]), 
      1 / ((1+DiscountRate[l,es,d])**(tt.val-t.val)))
 
        ;
EQUATION E_uTKexp_tEnd[l,es,d,t];
E_uTKexp_tEnd[l,es,d,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology) and (t.val > tend.val-lifespan[l,es,d,t]+1 and d1sqtpotential[l,es,d,t])) and utkexp_exists_dummy[l,es,d,t])..  
    uTKexp[l,es,d,t]  =E=  
     (uTI[l,es,d,t] 
      + sum(tt$(tt.val >= t.val and tt.val <= tend.val and tt.val < t.val+LifeSpan[l,es,d,t] and d1sqTPotential[l,es,d,tt]), 
      uTC[l,es,d,tt] / ((1+DiscountRate[l,es,d])**(tt.val-t.val)))
 
      + (1/(1+DiscountRate[l,es,d]))**(1+tEnd.val-t.val)*({uTC[l,es,d,tEnd]} * (1 - (1/(1+{DiscountRate[l,es,d]}))**{LifeSpan[l,es,d,t]-1+t.val-tEnd.val}) / (1 - (1/(1+{DiscountRate[l,es,d]}))))
) 
      / (sum(tt$(tt.val >= t.val and tt.val <= tend.val and tt.val < t.val+LifeSpan[l,es,d,t] and d1sqTPotential[l,es,d,tt]), 
      1 / ((1+DiscountRate[l,es,d])**(tt.val-t.val)))
 
       + (1/(1+DiscountRate[l,es,d]))**(1+tEnd.val-t.val)*({1} * (1 - (1/(1+{DiscountRate[l,es,d]}))**{LifeSpan[l,es,d,t]-1+t.val-tEnd.val}) / (1 - (1/(1+{DiscountRate[l,es,d]}))))
) 
       ;

# ----- gamY: Initialize energy_technology_LCOE_equations model -----
MODEL energy_technology_LCOE_equations / 
E_uTKexp_l_es_d, E_uTKexp_tEnd
 /;


# 2.1 Core Model Equations

# ----- gamY: Initialize energy_technology_equations_core equation block -----

# ----- gamY: Initialize energy_technology_endogenous_core group -----
EQUATION E_uTKmargNoBound_l_es_d[l,es,d,t];
E_uTKmargNoBound_l_es_d[l,es,d,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology)) and utkmargnobound_exists_dummy[l,es,d,t])..  pESmarg[es,d,t]  =E=  
    sum(e$(d1pEpj[es,e,d,t] and d1uTE[l,es,e,d,t]), uTE[l,es,e,d,t]*pEpj_marg[es,e,d,t]) + 
    uTKmargNoBound[l,es,d,t]*pTK[d,t];
EQUATION E_uTKmarg_l_es_d[l,es,d,t];
E_uTKmarg_l_es_d[l,es,d,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology)) and utkmarg_exists_dummy[l,es,d,t])..  uTKmarg[l,es,d,t]  =E=  max(0.0001, uTKmargNoBound[l,es,d,t]);
EQUATION E_sqT_l_es_d[l,es,d,t];
E_sqT_l_es_d[l,es,d,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology)) and sqt_exists_dummy[l,es,d,t])..  sqT[l,es,d,t]  =E=  
    sqTPotential[l,es,d,t]*errorf((log(((uTKmarg[l,es,d,t]/uTKexp[l,es,d,t])**2)**0.5) + 0.5*eP[l,es,d,t]**2)/eP[l,es,d,t]) 
;
EQUATION E_pESmarg_es_d[es,d,t];
E_pESmarg_es_d[es,d,t]$(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology)) and pesmarg_exists_dummy[es,d,t])..  1  =E=  sum(l$(d1sqTPotential[l,es,d,t]), sqT[l,es,d,t]);

