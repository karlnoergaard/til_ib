E_pY_CET_out_i[out,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and py_cet_exists_dummy[out,i,t])..  pY_CET[out,i,t]  =E=  pY0_CET[out,i,t] * (1 + rMarkup_out_i[out,i,t]);
EQUATION E_pY0_CET_out_i[out,i,t];
E_pY0_CET_out_i[out,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and py0_cet_exists_dummy[out,i,t])..  
      qY_CETgross[out,i,t]  =E=  uY_CET[out,i,t] * (pY0_CET[out,i,t]/pY0_i[i,t])**eCET[i] * qY0_i[i,t];
EQUATION E_qY_CETgross_out_i[out,i,t];
E_qY_CETgross_out_i[out,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qy_cetgross_exists_dummy[out,i,t])..  qY_CETgross[out,i,t]  =E=  qY_CET[out,i,t] + qY_CETown[out,i,t];
EQUATION E_qY_CETown_e_i[e,i,t];
E_qY_CETown_e_i[e,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qy_cetown_exists_dummy[e,i,t])..  qY_CETown[e,i,t]  =E=  sum((es,d)$(d1pEpj_own[es,e,d,t]), qEpj[es,e,d,t]) * qY_CETgross[e,i,t]/sum(i_a, qY_CETgross[e,i_a,t]);

# ----- gamY: Initialize production_CET model -----
MODEL production_CET / 
E_pY_CET_out_i, E_pY0_CET_out_i, E_qY_CETgross_out_i, E_qY_CETown_e_i
 /;

  
