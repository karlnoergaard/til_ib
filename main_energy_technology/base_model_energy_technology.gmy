# ----- gamY: Initialize production_equations equation block -----

# ----- gamY: Initialize production_endogenous group -----
EQUATION E_qY0_i[i,t];
E_qY0_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qy0_i_exists_dummy[i,t])..  qY0_i[i,t]  =E=  qPFtop2qY[i,t] * qY_i[i,t];
EQUATION E_qProd_pf_top_i[pf_top,i,t];
E_qProd_pf_top_i[pf_top,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qprod_exists_dummy[pf_top,i,t])..  qProd[pf_top,i,t]  =E=  qY0_i[i,t] + sum(k, qInstCost_k_i[k,i,t]);
EQUATION E_pY0_i[i,t];
E_pY0_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and py0_i_exists_dummy[i,t])..  pY0_i[i,t] * qY0_i[i,t]  =E=  pProd['TopPfunction',i,t] * qProd['TopPfunction',i,t]
                                + vProdOtherProductionCosts[i,t];
EQUATION E_pProd2pNest_pf_pfNest_i[pf,pfnest,i,t];
E_pProd2pNest_pf_pfNest_i[pf,pfnest,i,t]$(((t1.val <= t.val and t.val <= tend.val) and (pf_mapping[pfnest,pf,i])) and pprod2pnest_exists_dummy[pf,pfnest,i,t]).. 
      pProd2pNest[pf,pfNest,i,t]  =E=  pProd[pf,i,t] / pProd[pfNest,i,t];
EQUATION E_qProd_pf_i[pf,i,t];
E_qProd_pf_i[pf,i,t]$(((t1.val <= t.val and t.val <= tend.val) and (not pf_top[pf])) and qprod_exists_dummy[pf,i,t]).. 
      qProd[pf,i,t]  =E=  uProd[pf,i,t]
                      * sum(pf_mapping[pfNest,pf,i],
                          pProd2pNest[pf,pfNest,i,t]**(-eProd[pfNest,i]) * qProd[pfNest,i,t]
                      );
EQUATION E_pProd_pfNest_i[pfnest,i,t];
E_pProd_pfNest_i[pfnest,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and pprod_exists_dummy[pfnest,i,t])..  pProd[pfNest,i,t] * qProd[pfNest,i,t]  =E=  sum(pf_mapping[pfNest,pf,i], pProd[pf,i,t] * qProd[pf,i,t]);
EQUATION E_vProdOtherProductionCosts_i[i,t];
E_vProdOtherProductionCosts_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and vprodotherproductioncosts_exists_dummy[i,t])..  vProdOtherProductionCosts[i,t]  =E=  
                                            vtY_i_NetTaxSub[i,t]           
                                           -jvtBotded[i,t]                   
                                          + jvEnergycostsnotinnesting[i,t]   
                                          - vNetGov2Corp_xIO[i,t];
EQUATION E_vGVA_i[i,t];
E_vGVA_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and vgva_i_exists_dummy[i,t])..  vGVA_i[i,t]  =E=  sum(pf_top, pProd[pf_top,i,t]*qProd[pf_top,i,t]) - pProd['RxE',i,t]*qProd['RxE',i,t]
                      -sum(pf_bottom_e, pProd[pf_bottom_e,i,t]*qProd[pf_bottom_e,i,t]);

# ----- gamY: Initialize production_equations model -----
MODEL production_equations / 
E_qY0_i, E_qProd_pf_top_i, E_pY0_i, E_pProd2pNest_pf_pfNest_i, E_qProd_pf_i, E_pProd_pfNest_i, E_vProdOtherProductionCosts_i, E_vGVA_i
 /;

  
# ----- gamY: Initialize production_bottom_link_equations equation block -----

# ----- gamY: Initialize production_bottom_link_endogenous group -----
EQUATION E_pProd_RxE_i[rxe,i,t];
E_pProd_RxE_i[rxe,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and pprod_exists_dummy[rxe,i,t])..  pProd[RxE,i,t]  =E=  pD[i,t] + jpProd[Rxe,i,t];
EQUATION E_qR2qY_i[i,t];
E_qR2qY_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qr2qy_i_exists_dummy[i,t])..  qD[i,t]  =E=  qProd['RxE',i,t];
EQUATION E_pProd_pf_bottom_capital_i[pf_bottom_capital,i,t];
E_pProd_pf_bottom_capital_i[pf_bottom_capital,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and pprod_exists_dummy[pf_bottom_capital,i,t])..  pProd[pf_bottom_capital,i,t]  =E=  sum(sameas[pf_bottom_capital,k], pK_k_i[k,i,t] / pK_k_i[k,i,tBase]);
EQUATION E_qK2qY_k_i[k,i,t];
E_qK2qY_k_i[k,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qk2qy_k_i_exists_dummy[k,i,t])..  sum(sameas[pf_bottom_capital,k], qProd[pf_bottom_capital,i,t])  =E=  qK_k_i[k,i,t] * pK_k_i[k,i,tBase];
EQUATION E_pProd_pf_bottom_e_i[pf_bottom_e,i,t];
E_pProd_pf_bottom_e_i[pf_bottom_e,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and pprod_exists_dummy[pf_bottom_e,i,t])..  pProd[pf_bottom_e,i,t]  =E=  sum(pf_bottom_e2re[pf_bottom_e,re], pE_re_i[re,i,t]) + jpProd[pf_bottom_e,i,t];
EQUATION E_qE2qY_re_i[re,i,t];
E_qE2qY_re_i[re,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qe2qy_re_i_exists_dummy[re,i,t])..   
      qE_re_i[re,i,t]  =E=  sum(pf_bottom_e2re[pf_bottom_e,re], qProd[pf_bottom_e,i,t]) + jqE_re_i[re,i,t];
EQUATION E_pProd_labor_i[labor,i,t];
E_pProd_labor_i[labor,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and pprod_exists_dummy[labor,i,t])..  pProd[labor,i,t]  =E=  pL_i[i,t];
EQUATION E_qL2qY_i[i,t];
E_qL2qY_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and ql2qy_i_exists_dummy[i,t])..  qL_i[i,t]  =E=  qProd['labor',i,t];

# ----- gamY: Initialize production_bottom_link_equations model -----
MODEL production_bottom_link_equations / 
E_pProd_RxE_i, E_qR2qY_i, E_pProd_pf_bottom_capital_i, E_qK2qY_k_i, E_pProd_pf_bottom_e_i, E_qE2qY_re_i, E_pProd_labor_i, E_qL2qY_i
 /;

  # Add equation and endogenous variables to main model
  model main /
    production_equations
    production_bottom_link_equations
  /;



