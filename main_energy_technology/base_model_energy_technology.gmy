E_pY[t]$(((t1.val <= t.val and t.val <= tend.val)) and py_exists_dummy[t])..  pY[t] * qY[t]  =E=  vY[t];
EQUATION E_qY[t];
E_qY[t]$(((t1.val <= t.val and t.val <= tend.val)) and qy_exists_dummy[t])..  qY[t] * pY[t-1]  =E=  sum(i, pY_i[i,t-1] * qY_i[i,t]);
EQUATION E_qY_i[i,t];
