# ----- gamY: IF "equations" == "equations": -----

		# ------------------------------------------------------------------------------
		# Demand prices
		# ------------------------------------------------------------------------------

		
# ----- gamY: Initialize energy_demand_prices equation block -----

# ----- gamY: Initialize energy_demand_prices_endogenous group -----
EQUATION E_pEpj_base_es_e_d[es,e,d,t];
E_pEpj_base_es_e_d[es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and pepj_base_exists_dummy[es,e,d,t])..  pEpj_base[es,e,d,t]  =E=  (1+fpE[es,e,d,t]) * pE_avg[e,t];
EQUATION E_pEpj_own_es_e_d[es,e,d,t];
E_pEpj_own_es_e_d[es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and pepj_own_exists_dummy[es,e,d,t])..  pEpj_own[es,e,d,t]  =E=  sum(i,pY_CET[e,i,t]);
EQUATION E_pEpj_marg_base[es,e,d,t];
E_pEpj_marg_base[es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1pepj_base[es,e,d,t])) and pepj_marg_exists_dummy[es,e,d,t]).. 
			 pEpj_marg[es,e,d,t]  =E=  (1+tpE_marg[es,e,d,t]) * pEpj_base[es,e,d,t];
EQUATION E_pEpj_marg_nonpriced[es,e,d,t];
E_pEpj_marg_nonpriced[es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1tqepj[es,e,d,t])) and pepj_marg_exists_dummy[es,e,d,t]).. 
				pEpj_marg[es,e,d,t]  =E=  tqE_marg[es,e,d,t];
EQUATION E_pEpj_marg_own[es,e,d,t];
E_pEpj_marg_own[es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1pepj_own[es,e,d,t])) and pepj_marg_exists_dummy[es,e,d,t]).. 
				pEpj_marg[es,e,d,t]  =E=  (1+tpE_marg[es,e,d,t]) * pEpj_own[es,e,d,t];
EQUATION E_vEpj_base_es_e_d[es,e,d,t];
E_vEpj_base_es_e_d[es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and vepj_base_exists_dummy[es,e,d,t])..  vEpj_base[es,e,d,t]  =E=  pEpj_base[es,e,d,t] * qEpj[es,e,d,t];
EQUATION E_vEpj_NAS_es_e_d[es,e,d,t];
E_vEpj_NAS_es_e_d[es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and vepj_nas_exists_dummy[es,e,d,t])..  vEpj_NAS[es,e,d,t]  =E=   vEpj_base[es,e,d,t]
															 + vtE_NAS[es,e,d,t] 
															;
EQUATION E_vEpj_es_e_d[es,e,d,t];
E_vEpj_es_e_d[es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and vepj_exists_dummy[es,e,d,t])..  vEpj[es,e,d,t]  =E=  vEpj_NAS[es,e,d,t] + sum(i, vE_margins[es,e,d,i,t]);

# ----- gamY: Initialize energy_demand_prices model -----
MODEL energy_demand_prices / 
E_pEpj_base_es_e_d, E_pEpj_own_es_e_d, E_pEpj_marg_base, E_pEpj_marg_nonpriced, E_pEpj_marg_own, E_vEpj_base_es_e_d, E_vEpj_NAS_es_e_d, E_vEpj_es_e_d
 /;

	# ------------------------------------------------------------------------------
	# Market clearing
	# ------------------------------------------------------------------------------

	
# ----- gamY: Initialize energy_markets_clearing equation block -----

# ----- gamY: Initialize energy_markets_clearing_endogenous group -----
EQUATION E_qY_CET_SeveralNonExoSuppliers[e,i,t];
E_qY_CET_SeveralNonExoSuppliers[e,i,t]$(((t1.val <= t.val and t.val <= tend.val) and (not d1onesx[e,t])) and qy_cet_exists_dummy[e,i,t]).. 
				qY_CET[e,i,t] * (sum(i_a$d1pY_CET[e,i_a,t], sY_Dist[e,i_a,t] * pY_CET[e,i_a,t] ** (-eDist[e])) + sum(i_a$d1pM_CET[e,i_a,t], sM_Dist[e,i_a,t] * pM_CET[e,i_a,t]**(-eDist[e]))) 
									 =E=  sY_Dist[e,i,t] * pY_CET[e,i,t] **(-eDist[e]) * qEtot[e,t];
EQUATION E_qM_CET_SeveralNonExoSuppliers[e,i,t];
E_qM_CET_SeveralNonExoSuppliers[e,i,t]$(((t1.val <= t.val and t.val <= tend.val) and (not d1onesx[e,t])) and qm_cet_exists_dummy[e,i,t]).. 
				qM_CET[e,i,t] * (sum(i_a$d1pY_CET[e,i_a,t], sY_Dist[e,i_a,t] * pY_CET[e,i_a,t] ** (-eDist[e])) + sum(i_a$d1pM_CET[e,i_a,t], sM_Dist[e,i_a,t] * pM_CET[e,i_a,t]**(-eDist[e]))) 
									 =E=  sM_Dist[e,i,t] * pM_CET[e,i,t] **(-eDist[e]) * qEtot[e,t];
EQUATION E_pE_avg_e[e,t];
E_pE_avg_e[e,t]$(((t1.val <= t.val and t.val <= tend.val) and (sum(i, d1py_cet[e,i,t] or d1pm_cet[e,i,t]))) and pe_avg_exists_dummy[e,t])..  pE_avg[e,t] * qEtot[e,t]  =E=   sum(i$(d1pY_CET[e,i,t]), pY_CET[e,i,t]*qY_CET[e,i,t]) 
															+ sum(i$(d1pM_CET[e,i,t]), pM_CET[e,i,t]*qM_CET[e,i,t]);
EQUATION E_qY_CET_OneSupplier[e,i,t];
E_qY_CET_OneSupplier[e,i,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1onesx_y[e,t] and not d1onesx_m[e,t])) and qy_cet_exists_dummy[e,i,t])..  qY_CET[e,i,t]  =E=  qEtot[e,t];
EQUATION E_qM_CET_OneSupplier[e,i,t];
E_qM_CET_OneSupplier[e,i,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1onesx_m[e,t] and not d1onesx_y[e,t])) and qm_cet_exists_dummy[e,i,t])..  qM_CET[e,i,t]  =E=  qEtot[e,t];
EQUATION E_qM_CET_ExoSuppliers[e,i,t];
E_qM_CET_ExoSuppliers[e,i,t]$(((t1.val <= t.val and t.val <= tend.val) and (d1onesx_y[e,t] and d1onesx_m[e,t])) and qm_cet_exists_dummy[e,i,t])..  qM_CET[e,i,t]  =E=  qEtot[e,t] - sum(i_a, qY_CET[e,i_a,t]);
EQUATION E_qEtot_e[e,t];
E_qEtot_e[e,t]$(((t1.val <= t.val and t.val <= tend.val)) and qetot_exists_dummy[e,t])..  qEtot[e,t]  =E=  sum((es,d)$(d1pEpj_base[es,e,d,t] or tl[d]), qEpj[es,e,d,t]);
EQUATION E_vDistributionProfits_e[e,t];
E_vDistributionProfits_e[e,t]$(((t1.val <= t.val and t.val <= tend.val)) and vdistributionprofits_exists_dummy[e,t])..  vDistributionProfits[e,t]  =E=  sum((es,d), pEpj_base[es,e,d,t] * qEpj[es,e,d,t])
																	  	- sum(i,   pY_CET[e,i,t] * qY_CET[e,i,t])
																	  	- sum(i,   pM_CET[e,i,t] * qM_CET[e,i,t]);
EQUATION E_vY_CET_e_i[e,i,t];
E_vY_CET_e_i[e,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and vy_cet_exists_dummy[e,i,t])..  vY_CET[e,i,t]  =E=  pY_CET[e,i,t] * qY_CET[e,i,t];
EQUATION E_vM_CET_e_i[e,i,t];
E_vM_CET_e_i[e,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and vm_cet_exists_dummy[e,i,t])..  vM_CET[e,i,t]  =E=  pM_CET[e,i,t] * qM_CET[e,i,t];

# ----- gamY: Initialize energy_markets_clearing model -----
MODEL energy_markets_clearing / 
E_qY_CET_SeveralNonExoSuppliers, E_qM_CET_SeveralNonExoSuppliers, E_pE_avg_e, E_qY_CET_OneSupplier, E_qM_CET_OneSupplier, E_qM_CET_ExoSuppliers, E_qEtot_e, E_vDistributionProfits_e, E_vY_CET_e_i, E_vM_CET_e_i
 /; 

