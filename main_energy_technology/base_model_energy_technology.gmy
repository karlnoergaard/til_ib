E_vY_i_d[i,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and vy_i_d_exists_dummy[i,d,t])..  vY_i_d[i,d,t]  =E=  pY_i_d[i,d,t] * qY_i_d[i,d,t];
