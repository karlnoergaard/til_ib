E_vtEmarg_es_e_d[es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and vtemarg_exists_dummy[es,e,d,t])..    vtEmarg[es,e,d,t]  =E=  (pEpj_marg[es,e,d,t] - pEpj_base[es,e,d,t] - pEpj_own[es,e,d,t] - sum(i,pE_margins[es,e,d,i,t])) * qEpj[es,e,d,t];
