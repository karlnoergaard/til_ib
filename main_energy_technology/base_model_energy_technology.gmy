# ----- gamY: Initialize ramsey_household_equations equation block -----

# ----- gamY: Initialize ramsey_household_endogenous group -----
EQUATION E_jC_ramsey[t];
E_jC_ramsey[t]$(((t1.val <= t.val and t.val <= tend.val) and (not t1[t])) and jc_ramsey_exists_dummy[t])..  qC[t]  =E=  qC_ramsey[t];
EQUATION E_qCHhxRef[t];
E_qCHhxRef[t]$(((t1.val <= t.val and t.val <= tend.val)) and qchhxref_exists_dummy[t])..  qCHhxRef[t]  =E=  qC_ramsey[t] - rCHabit[t] * qC_ramsey[t-1]/fq - rMPC[t] * vHhIncome[t] / pC[t];
EQUATION E_qmuC[t];
E_qmuC[t]$(((t1.val <= t.val and t.val <= tend.val)) and qmuc_exists_dummy[t])..  qmuC[t]  =E=  (qCHhxRef[t]/qCHhxRef[tBase])**(-eCRRA);
EQUATION E_qC_ramsey[t];
E_qC_ramsey[t]$(((t1.val <= t.val and t.val <= tend.val) and (not tend[t])) and qc_ramsey_exists_dummy[t]).. 
    qmuC[t]  =E=  pC[t]/(pC[t+1]*fp) * (1+rHh[t+1]*(1-trHh[t+1])) 
              * qmuC[t+1]*fq**(-eCRRA) 
              * rSurvival[t] / (1+rHhDiscount[t+1]);
EQUATION E_qC_ramsey_tEnd[t];
E_qC_ramsey_tEnd[t]$(((t1.val <= t.val and t.val <= tend.val) and (tend[t] and not t1[t])) and qc_ramsey_exists_dummy[t])..  vNetFinAssets['Hh',t]  =E=  vNetFinAssets['Hh',t-1];

# ----- gamY: Initialize ramsey_household_equations model -----
MODEL ramsey_household_equations / 
E_jC_ramsey, E_qCHhxRef, E_qmuC, E_qC_ramsey, E_qC_ramsey_tEnd
 /;

# Add equation and endogenous variables to main model
model main / ramsey_household_equations /;



