  #BLOCK 1/3, BOTTOM-UP EMISSIONS
  
# ----- gamY: Initialize emissions_BU equation block -----

# ----- gamY: Initialize emissions_BU_endogenous group -----
EQUATION E_qEmmE_BU_notNatgas[em,es,e,d,t];
E_qEmmE_BU_notNatgas[em,es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (not co2e[em] and not (natgas[e] and (co2ubio[em] or co2bio[em])))) and qemme_bu_exists_dummy[em,es,e,d,t]).. 
        qEmmE_BU[em,es,e,d,t]  =E=  uEmmE_BU[em,es,e,d,t] * qEpj[es,e,d,t];
EQUATION E_qEmmE_BU_BioNatgas[em,es,e,d,t];
E_qEmmE_BU_BioNatgas[em,es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (not co2e[em] and natgas[e] and co2bio[em])) and qemme_bu_exists_dummy[em,es,e,d,t]).. 
        qEmmE_BU[em,es,e,d,t]  =E=  sBioNatGas[t] * uEmmE_BU[em,es,e,d,t] * qEpj[es,e,d,t];
EQUATION E_qEmmE_BU_FossileNatgas[em,es,e,d,t];
E_qEmmE_BU_FossileNatgas[em,es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (not co2e[em] and natgas[e] and co2ubio[em])) and qemme_bu_exists_dummy[em,es,e,d,t]).. 
        qEmmE_BU[em,es,e,d,t]  =E=  (1-sBioNatGas[t]) * uEmmE_BU[em,es,e,d,t] * qEpj[es,e,d,t];
EQUATION E_qEmmE_BU_CO2e[em,es,e,d,t];
E_qEmmE_BU_CO2e[em,es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (co2e[em])) and qemme_bu_exists_dummy[em,es,e,d,t]).. 
        qEmmE_BU['CO2e',es,e,d,t]  =E=  sum(em_a$(not CO2e[em_a]), GWP[em_a] * qEmmE_BU[em_a,es,e,d,t]);

# ----- gamY: Initialize emissions_BU model -----
MODEL emissions_BU / 
E_qEmmE_BU_notNatgas, E_qEmmE_BU_BioNatgas, E_qEmmE_BU_FossileNatgas, E_qEmmE_BU_CO2e
 /; 

  #BLOCK 2/3 EMISSIONS AGGREGATES - CAN RUN SEPARATELY OF BOTTOM-UP EMISSIONS. WHEN LINKING 1 AND 2 (THROUGH 3) CALIBRATION VARAIBLES IN 2 ARE ENDOGENIZED TO MATCH BOTTOM-UP EMISSIONS
  
# ----- gamY: Initialize emissions_aggregates equation block -----

# ----- gamY: Initialize emissions_aggregates_endogenous group -----
EQUATION E_qEmmE_production[em,i,t];
E_qEmmE_production[em,i,t]$(((t1.val <= t.val and t1.val <=tend.val) and (not co2e[em])) and qemme_exists_dummy[em,i,t]).. 
        qEmmE[em,i,t]  =E=  uEmmE[em,i,t] * (qProd['Machine_energy',i,t] + qProd['Transport_energy',i,t] + qProd['Heating_energy',i,t]);
EQUATION E_qEmmE_households[em,c,t];
E_qEmmE_households[em,c,t]$(((t1.val <= t.val and t1.val <=tend.val) and (not co2e[em])) and qemme_exists_dummy[em,c,t]).. 
        qEmmE[em,c,t]  =E=  uEmmE[em,c,t] * sum(cf_bottom$c2cf_bottom_mapping[c,cf_bottom], qChh[cf_bottom,t]);
EQUATION E_qEmmE_rest[em,d,t];
E_qEmmE_rest[em,d,t]$(((t1.val <= t.val and t1.val <=tend.val) and (not (i[d] or c[d]) and not co2e[em])) and qemme_exists_dummy[em,d,t]).. 
        qEmmE[em,d,t]  =E=  uEmmE[em,d,t];
EQUATION E_qEmmE_CO2e[em,d,t];
E_qEmmE_CO2e[em,d,t]$(((t1.val <= t.val and t1.val <=tend.val) and (co2e[em])) and qemme_exists_dummy[em,d,t]).. 
      qEmmE['CO2e',d,t]  =E=  sum(em_a$(not CO2e[em_a]), GWP[em_a] * qEmmE[em_a,d,t]);
EQUATION E_qEmmxE_production[em,i,t];
E_qEmmxE_production[em,i,t]$(((t1.val <= t.val and t1.val <=tend.val) and (not co2e[em])) and qemmxe_exists_dummy[em,i,t]).. 
      qEmmxE[em,i,t]  =E=  uEmmxE[em,i,t] * sum(pf_top, qProd[pf_top,i,t]);
EQUATION E_qEmmxEnot_production[em,d,t];
E_qEmmxEnot_production[em,d,t]$(((t1.val <= t.val and t1.val <=tend.val) and (not i[d] and not co2e[em])) and qemmxe_exists_dummy[em,d,t]).. 
      qEmmxE[em,d,t]  =E=  uEmmxE[em,d,t];
EQUATION E_qEmmxE_CO2e[em,d,t];
E_qEmmxE_CO2e[em,d,t]$(((t1.val <= t.val and t1.val <=tend.val) and (co2e[em])) and qemmxe_exists_dummy[em,d,t]).. 
      qEmmxE['CO2e',d,t]  =E=  sum(em_a$(not CO2e[em_a]), GWP[em_a] * qEmmxE[em_a,d,t]);
EQUATION E_qEmmTot_em_em_accounts[em,em_accounts,t];
E_qEmmTot_em_em_accounts[em,em_accounts,t]$(((t1.val <= t.val and t1.val <=tend.val)) and qemmtot_exists_dummy[em,em_accounts,t])..   qEmmTot[em,em_accounts,t]  =E=  sum(d, qEmmE[em,d,t]) 
                                    + sum(d, qEmmxE[em,d,t]) 
                                    + qEmmLULUCF[t]$(gna_lulufc[em_accounts] or unfccc_lulucf[em_accounts])              
                                    - qEmmBorderTrade[em,t]$(unfccc[em_accounts] or unfccc_lulucf[em_accounts])                
                                    - qEmmBunkering[em,t]$(unfccc[em_accounts] or unfccc_lulucf[em_accounts])            
                                    - qEmmInternationalAviation[em,t]$(unfccc[em_accounts] or unfccc_lulucf[em_accounts])
                                    - qEmmOtherDifferencesShips[em,t]$(unfccc[em_accounts] or unfccc_lulucf[em_accounts])
                                    ;

# ----- gamY: Initialize emissions_aggregates model -----
MODEL emissions_aggregates / 
E_qEmmE_production, E_qEmmE_households, E_qEmmE_rest, E_qEmmE_CO2e, E_qEmmxE_production, E_qEmmxEnot_production, E_qEmmxE_CO2e, E_qEmmTot_em_em_accounts
 /; 

  #BLOCK 3/3, LINKING EMISSIONS AGGREGATES AND BOTTOM-UP EMISSIONS
  
# ----- gamY: Initialize emissions_aggregates_link equation block -----

# ----- gamY: Initialize emissions_aggregates_link_endogenous group -----
EQUATION E_uEmmE_em_d[em,d,t];
E_uEmmE_em_d[em,d,t]$(((t1.val <= t.val and t1.val <=tend.val) and (not co2e[em])) and uemme_exists_dummy[em,d,t])..  qEmmE[em,d,t]  =E=  sum((e,es), qEmmE_BU[em,es,e,d,t]);
EQUATION E_qEmmInternationalAviation_em[em,t];
E_qEmmInternationalAviation_em[em,t]$(((t1.val <= t.val and t1.val <=tend.val)) and qemminternationalaviation_exists_dummy[em,t])..  qEmmInternationalAviation[em,t]  =E=  sum(i_international_aviation,qEmmE_BU[em,'transport','jet petroleum',i_international_aviation,t]);
EQUATION E_qEmmBunkering_em[em,t];
E_qEmmBunkering_em[em,t]$(((t1.val <= t.val and t1.val <=tend.val)) and qemmbunkering_exists_dummy[em,t])..  qEmmBunkering[em,t]  =E=  sum((i,es,eBunkering), qEmmE_BU[em,es,eBunkering,i,t]);
EQUATION E_qEmmOtherDifferencesShips_em[em,t];
E_qEmmOtherDifferencesShips_em[em,t]$(((t1.val <= t.val and t1.val <=tend.val)) and qemmotherdifferencesships_exists_dummy[em,t])..  qEmmOtherDifferencesShips[em,t]  =E=  qEmmE_BU[em,'transport','diesel for transport','49509',t];

# ----- gamY: Initialize emissions_aggregates_link model -----
MODEL emissions_aggregates_link / 
E_uEmmE_em_d, E_qEmmInternationalAviation_em, E_qEmmBunkering_em, E_qEmmOtherDifferencesShips_em
 /; 

  model main / 
              emissions_BU
              emissions_aggregates 
              emissions_aggregates_link
              /;


# ----- gamY: ENDIF -----



