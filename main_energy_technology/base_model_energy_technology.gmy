E_tCO2_ETS2_pj_NatgasuBio[em,es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val) and (natgas[e] and co2ubio[em])) and tco2_ets2_pj_exists_dummy[em,es,e,d,t]).. 
