EQUATION E_vtE_NAS_es_e_d[es,e,d,t];
E_vtE_NAS_es_e_d[es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and vte_nas_exists_dummy[es,e,d,t])..    vtE_NAS[es,e,d,t]  =E=  vtE_vat[es,e,d,t] 
                            + sum(etaxes, vtE_duty[etaxes,es,e,d,t])
                            ;
EQUATION E_vtE_es_e_d[es,e,d,t];
E_vtE_es_e_d[es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and vte_exists_dummy[es,e,d,t])..    vtE[es,e,d,t]  =E=  vtE_NAS[es,e,d,t]
                            + sum(em, tCO2_ETS_pj[em,es,e,d,t]*qEpj[es,e,d,t])
                            + sum(em, tCO2_ETS2_pj[em,es,e,d,t]*qEpj[es,e,d,t])
