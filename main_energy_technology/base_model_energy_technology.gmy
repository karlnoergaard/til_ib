EQUATION E_qL[t];
E_qL[t]$(((t1.val <= t.val and t.val <= tend.val)) and ql_exists_dummy[t])..  qL[t]  =E=  sum(i, qL_i[i,t]);
EQUATION E_pW[t];
E_pW[t]$(((t1.val <= t.val and t.val <= tend.val)) and pw_exists_dummy[t])..  qL[t]  =E=  qProductivity[t] * nL[t];
EQUATION E_pL_i[i,t];
E_pL_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and pl_i_exists_dummy[i,t])..  pL_i[i,t]  =E=  pW[t] + pLWedge_i[i,t];
EQUATION E_vWages_i[i,t];
E_vWages_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and vwages_i_exists_dummy[i,t])..  vWages_i[i,t]  =E=  pW[t] * qL_i[i,t];
EQUATION E_vWages[t];
E_vWages[t]$(((t1.val <= t.val and t.val <= tend.val)) and vwages_exists_dummy[t])..  vWages[t]  =E=  sum(i, vWages_i[i,t]);
EQUATION E_vW[t];
E_vW[t]$(((t1.val <= t.val and t.val <= tend.val)) and vw_exists_dummy[t])..  vW[t]  =E=  pW[t] * qProductivity[t];
EQUATION E_rWageInflation[t];
E_rWageInflation[t]$(((t1.val <= t.val and t.val <= tend.val)) and rwageinflation_exists_dummy[t])..  rWageInflation[t]  =E=  vW[t] / (vW[t-1]/fv) - 1;
EQUATION E_nL[t];
E_nL[t]$(((t1.val <= t.val and t.val <= tend.val) and (not tend[t])) and nl_exists_dummy[t]).. 
    rWageInflation[t]  =E=  rWageInflation[t-1]
                        + uPhillipsCurveEmpl[t] * (nL[t] / snL[t] - 1)
                        + uPhillipsCurveExpWage[t] * (rWageInflation[t+1] - rWageInflation[t-1])
                        + jnL[t];
EQUATION E_nL_tEnd[t];
E_nL_tEnd[t]$(((t1.val <= t.val and t.val <= tend.val) and (tend[t])) and nl_exists_dummy[t]).. 
    rWageInflation[t]  =E=  rWageInflation[t-1]
                        + uPhillipsCurveEmpl[t] * (nL[t] / snL[t] - 1)
                        + jnL[t];

# ----- gamY: Initialize labor_market_equations model -----
MODEL labor_market_equations / 
E_qL, E_pW, E_pL_i, E_vWages_i, E_vWages, E_vW, E_rWageInflation, E_nL, E_nL_tEnd
 /;

