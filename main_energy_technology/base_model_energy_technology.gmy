# ----- gamY: Import file: c:\greu_ib\GREU\model\modules/03_energy_technology.gms ----- 

# ------------------------------------------------------------------------------
# Energy Technology Choice Model
# ------------------------------------------------------------------------------
# This partial model implements the technology choice model for energy services
# using a smooth transition approach with log-normal distributions.

# ------------------------------------------------------------------------------
# 1. Variable and Dummy Definitions
# ------------------------------------------------------------------------------

# ----- gamY: IF "exogenous_values" == "variables": -----
# If condition evaluated to false
# ----- gamY: ENDIF -----
 # variables

# ------------------------------------------------------------------------------
# 2. Model Equations
# ------------------------------------------------------------------------------

# ----- gamY: IF "exogenous_values" == "equations": -----
# If condition evaluated to false
# ----- gamY: ENDIF -----
 # equations

# ------------------------------------------------------------------------------
# 3. Data and Parameters
# ------------------------------------------------------------------------------

# ----- gamY: IF "exogenous_values" == "exogenous_values": -----


# 3.1 Data Loading
# ----- gamY: Initialize energy_technology_data_variables group -----


# Load data from generic dummy data

# ----- gamY: IF 0 == 1: -----
# If condition evaluated to false
# ----- gamY: ENDIF -----


# Load data from excel-based data

# ----- gamY: IF 0 == 0: -----
$offlisting
  parameters
    
# ----- gamY: Loop over energy_technology_data_variables -----

      sqTPotential__load__[l,es,d,t]
      uTE__load__[l,es,e,d,t]
      uTI__load__[l,es,d,t]
      uTC__load__[l,es,d,t]
      pTK__load__[d,t]
      qES__load__[es,d,t]
  ;
$onDotL
  execute_load "../data/Energy_technology_data/Excel_data/Energy_technology_data.gdx" 
# ----- gamY: Loop over energy_technology_data_variables -----
 sqTPotential__load__=sqTPotential  uTE__load__=uTE  uTI__load__=uTI  uTC__load__=uTC  pTK__load__=pTK  qES__load__=qES ;
$offDotL
$offlisting
  
# ----- gamY: IF ".l" not in [".l", "", ".fx", ".up", ".lo"]: -----
# If condition evaluated to false
# ----- gamY: ENDIF -----

    
# ----- gamY: Loop over energy_technology_data_variables -----

      sqTPotential.l[l,es,d,t]$(1) = sqTPotential__load__[l,es,d,t];
      uTE.l[l,es,e,d,t]$(1) = uTE__load__[l,es,e,d,t];
      uTI.l[l,es,d,t]$(1) = uTI__load__[l,es,d,t];
      uTC.l[l,es,d,t]$(1) = uTC__load__[l,es,d,t];
      pTK.l[d,t]$(1) = pTK__load__[d,t];
      qES.l[es,d,t]$(1) = qES__load__[es,d,t];
$onlisting
;
$onlisting


  # Load LifeSpan from data.gdx
  execute_load "../data/Energy_technology_data/Excel_data/Energy_technology_data.gdx" LifeSpan=LifeSpan;

# ----- gamY: ENDIF -----


# 3.2 Initial Values
# Set discount rate
DiscountRate[l,es,d]$(sum(t, sqTPotential.l[l,es,d,t])) = 0.05;

# Set share parameter
jES.l[es,i,t]$(qES.l[es,i,t] and qREes.l[es,i,t]) = qES.l[es,i,t]/qREes.l[es,i,t];
jpTK.l[i,t]$(d1pTK[i,t] and d1K_k_i['iM',i,t]) = pTK.l[i,t]/pK_k_i.l['iM',i,t];

# 3.3 Dummy Variable Setup
# Set dummy determining the existence of technology potentials
d1sqTPotential[l,es,d,t] = yes$(sqTPotential.l[l,es,d,t]);
d1uTE[l,es,e,d,t] = yes$(uTE.l[l,es,e,d,t]);
d1pTK[d,t] = yes$(sum((l,es), d1sqTPotential[l,es,d,t]));
d1qES_e[es,e,d,t] = yes$(sum(l, d1uTE[l,es,e,d,t]));
d1qES[es,d,t] = yes$(qES.l[es,d,t]);
d1qI_k_i_energy_tech[k,i,t] = yes$(sum((l,es)$(es2k[es,k]), d1sqTPotential[l,es,i,t]));
d1switch_energy_technology = 1;
d1switch_integrate_energy_technology = 1;

# 4.4 Starting values for Levelized Cost of Energy (LCOE)
uTKexp.l[l,es,d,t]$(t.val <= tend.val-LifeSpan[l,es,d,t]+1 and d1sqTPotential[l,es,d,t]) =
   (uTI.l[l,es,d,t] # Investment costs
    + sum(tt$(tt.val >= t.val and tt.val <= tend.val and tt.val < t.val+LifeSpan[l,es,d,t] and d1sqTPotential[l,es,d,tt]), 
      uTC.l[l,es,d,tt] / ((1+DiscountRate[l,es,d])**(tt.val-t.val)))
) # Discounted variable costs
      / sum(tt$(tt.val >= t.val and tt.val <= tend.val and tt.val < t.val+LifeSpan[l,es,d,t] and d1sqTPotential[l,es,d,tt]), 
      1 / ((1+DiscountRate[l,es,d])**(tt.val-t.val)))
 # Dicounted denominator
      ;

  # Levelized cost of energy (LCOE) in technology l per PJ output at full potential
  uTKexp.l[l,es,d,t]$(t.val > tend.val-LifeSpan[l,es,d,t]+1 and d1sqTPotential[l,es,d,t]) =
     (uTI.l[l,es,d,t] # Investment costs
      + sum(tt$(tt.val >= t.val and tt.val <= tend.val and tt.val < t.val+LifeSpan[l,es,d,t] and d1sqTPotential[l,es,d,tt]), 
      uTC.l[l,es,d,tt] / ((1+DiscountRate[l,es,d])**(tt.val-t.val)))
 # Discounted variable costs until tEnd
      + (1/(1+DiscountRate[l,es,d]))**(1+tEnd.val-t.val)*({uTC.l[l,es,d,tEnd]} * (1 - (1/(1+{DiscountRate[l,es,d]}))**{LifeSpan[l,es,d,t]-1+t.val-tEnd.val}) / (1 - (1/(1+{DiscountRate[l,es,d]}))))
) # Discounted variable costs after tEnd (Assuming constant costs after tEnd)
      / (sum(tt$(tt.val >= t.val and tt.val <= tend.val and tt.val < t.val+LifeSpan[l,es,d,t] and d1sqTPotential[l,es,d,tt]), 
      1 / ((1+DiscountRate[l,es,d])**(tt.val-t.val)))
 # Discount denominator until tEnd
       + (1/(1+DiscountRate[l,es,d]))**(1+tEnd.val-t.val)*({1} * (1 - (1/(1+{DiscountRate[l,es,d]}))**{LifeSpan[l,es,d,t]-1+t.val-tEnd.val}) / (1 - (1/(1+{DiscountRate[l,es,d]}))))
) # Discounted denominator after tEnd
       ; 

pTPotential.l[l,es,d,t] = 
  sum(e, uTE.l[l,es,e,d,t]*pEpj_marg.l[es,e,d,t]) + uTKexp.l[l,es,d,t]*pTK.l[d,t];

smooth_factor = 0.05;

# Set smoothing parameters (we recalculate this in base_model_energy_technology.gms because electricity prices are not present in some cases in the data)
eP.l[l,es,d,t]$(sqTPotential.l[l,es,d,t]) = smooth_factor*pTPotential.l[l,es,d,t]/uTKexp.l[l,es,d,t];

jqESE_phaseout[t]$(t.val = tDataEnd.val) = 1;
jqESE_phaseout[t]$(t.val = tDataEnd.val+1) = 0.8;
jqESE_phaseout[t]$(t.val = tDataEnd.val+2) = 0.6;
jqESE_phaseout[t]$(t.val = tDataEnd.val+3) = 0.4;
jqESE_phaseout[t]$(t.val = tDataEnd.val+4) = 0.2;
jqESE_phaseout[t]$(t.val >= tDataEnd.val+5) = 0;


# ----- gamY: ENDIF -----
 # exogenous_values

# ------------------------------------------------------------------------------
# Starting values
# ------------------------------------------------------------------------------

# ----- gamY: IF "exogenous_values" == "starting_values": -----
# If condition evaluated to false
# ----- gamY: ENDIF -----
 # starting_values

