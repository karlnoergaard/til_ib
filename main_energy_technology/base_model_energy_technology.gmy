EQUATION E_pM_i_d[i,d,t];
E_pM_i_d[i,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and pm_i_d_exists_dummy[i,d,t])..  pM_i_d[i,d,t]  =E=  (1+tM_i_d[i,d,t]) * pM_i_d_base[i,d,t];
EQUATION E_pY_i_d_base_i_d[i,d,t];
E_pY_i_d_base_i_d[i,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and py_i_d_base_exists_dummy[i,d,t])..  pY_i_d_base[i,d,t]  =E=  (1+jfpY_i_d[i,d,t])/ (1+tY_i_d[i,d,tBase]) * pY_i[i,t];
