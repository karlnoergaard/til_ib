# ----- gamY: Import file: c:\greu_ib\GREU\model\modules/06_input_output.gms ----- 

# ======================================================================================================================
# Input-output
# Demand for energy, other intermediate inputs, investments, private and public consumption, and exports
# is allocated to imports and output from domestic industries.
# ======================================================================================================================

# ----------------------------------------------------------------------------------------------------------------------
# Variable and dummy definitions
# ----------------------------------------------------------------------------------------------------------------------

# ----- gamY: IF "equations" == "variables": -----
# If condition evaluated to false
# ----- gamY: ENDIF -----
 # variables

# ----------------------------------------------------------------------------------------------------------------------
# Equations
# ----------------------------------------------------------------------------------------------------------------------

# ----- gamY: IF "equations" == "equations": -----



# ----- gamY: Initialize input_output_equations equation block -----

# ----- gamY: Initialize input_output_endogenous group -----
EQUATION E_vGDP[t];
E_vGDP[t]$(((t1.val <= t.val and t.val <= tend.val)) and vgdp_exists_dummy[t])..  vGDP[t]  =E=  vC[t] + vI[t] + vG[t] + vX[t] - vM[t];
EQUATION E_pGDP[t];
E_pGDP[t]$(((t1.val <= t.val and t.val <= tend.val)) and pgdp_exists_dummy[t])..  pGDP[t] * qGDP[t]  =E=  vGDP[t];
EQUATION E_qGDP[t];
E_qGDP[t]$(((t1.val <= t.val and t.val <= tend.val)) and qgdp_exists_dummy[t])..  qGDP[t] * pGDP[t-1]  =E=  pC[t-1] * qC[t]
                           + pI[t-1] * qI[t]
                           + pG[t-1] * qG[t]
                           + pX[t-1] * qX[t]
                           - pM[t-1] * qM[t];
EQUATION E_vGVA[t];
E_vGVA[t]$(((t1.val <= t.val and t.val <= tend.val)) and vgva_exists_dummy[t])..  vGVA[t]  =E=  vY[t] - vR[t] - vE[t];
EQUATION E_pGVA[t];
E_pGVA[t]$(((t1.val <= t.val and t.val <= tend.val)) and pgva_exists_dummy[t])..  pGVA[t] * qGVA[t]  =E=  vGVA[t];
EQUATION E_qGVA[t];
E_qGVA[t]$(((t1.val <= t.val and t.val <= tend.val)) and qgva_exists_dummy[t])..  qGVA[t] * pGVA[t-1]  =E=  pY[t-1] * qY[t]
                           - pR[t-1] * qR[t]
                           - pE[t-1] * qE[t];
EQUATION E_vR[t];
E_vR[t]$(((t1.val <= t.val and t.val <= tend.val)) and vr_exists_dummy[t])..  vR[t]  =E=  sum(rx, vD[rx,t]);
EQUATION E_vE[t];
E_vE[t]$(((t1.val <= t.val and t.val <= tend.val)) and ve_exists_dummy[t])..  vE[t]  =E=  sum(re, vD[re,t]);
EQUATION E_vI[t];
E_vI[t]$(((t1.val <= t.val and t.val <= tend.val)) and vi_exists_dummy[t])..  vI[t]  =E=  sum(k, vD[k,t]) + vD['invt',t]+vD['invt_ene',t];
EQUATION E_vC[t];
E_vC[t]$(((t1.val <= t.val and t.val <= tend.val)) and vc_exists_dummy[t])..  vC[t]  =E=  sum(c, vD[c,t]) + vC_WalrasLaw[t];
EQUATION E_vG[t];
