# Create partial models to get starting values for the energy technology model

# ----- gamY: Import file: c:\greu_ib\GREU\model\pre_models_energy_technology.gms ----- 

# ======================================================================================================================
# Pre-models for the Energy Technology Choice Model
# ======================================================================================================================
# This module contains two pre-models:
# 1. A model for determining supply curves and initial values for the Energy Technology Choice Model
# 2. A model for determining energy prices for the Energy Technology Choice Model

# ======================================================================================================================
# MODEL 1: Setup for determining supply curves and initial values for the Energy Technology Choice Model
# ======================================================================================================================
# This module generates supply curves and sets initial values for the energy technology model.
# It creates scenario-specific versions of the model for supply curve analysis.

# ----------------------------------------------------------------------------------------------------------------------
# 1. Supply Curve Parameters
# ----------------------------------------------------------------------------------------------------------------------
# 1.1 Scenario Set Definition
set scen / 1*100 /; # Number of steps for tracing the supply curve
Set l_ord / 1*100 /; # Sorted technology positions
Alias (l_ord, ll_ord); # Alias

# 1.2 Key Parameters
parameter
  pTPotential_position[l,es,d,t] "Position of technology l in ascending order of pTPotential"
  pTPotential_sorted[l_ord,es,d,t] "Sorted technologies by price at full potential"
  sqTPotential_sorted[l_ord,es,d,t] "Sorted technologies by supply at full potential"
  sqTPotential_sorted_sum[l_ord,es,d,t] "Sum of sorted technologies by supply at full potential"
  pTPotential_marginal[es,d,t] "Price of the marginal technology (at the point where supply meets demand)"
  uTKmarg_eq[l,es,d,t]  "The marginal cost of capital in equilibrium, ie. at the point where demand is satisified"
  pESmarg_eq[es,d,t]    "The marginal cost of energy service in equilibrium, ie. at the point where demand is satisified"
;

# ----------------------------------------------------------------------------------------------------------------------
# 2. Scenario-Specific Model Setup
# ----------------------------------------------------------------------------------------------------------------------
# 2.1 Scenario Variable Creation
# ----- gamY: Initialize G_scenarios group -----
$offlisting
Variable uTKmargNoBound_scen[l,es,d,t,scen] "Alternate version of uTKmargNoBound used in {scenario} scenario." //;
SET uTKmargNoBound_scen_exists_dummy[l,es,d,t,scen];
Variable uTKmarg_scen[l,es,d,t,scen] "Alternate version of uTKmarg used in {scenario} scenario." //;
SET uTKmarg_scen_exists_dummy[l,es,d,t,scen];
Variable sqT_scen[l,es,d,t,scen] "Alternate version of sqT used in {scenario} scenario." //;
SET sqT_scen_exists_dummy[l,es,d,t,scen];
Variable pESmarg_scen[es,d,t,scen] "Alternate version of pESmarg used in {scenario} scenario." //;
SET pESmarg_scen_exists_dummy[es,d,t,scen];
$onlisting


# 2.2 Dummy Variable Setup
# Adding exists-dummies for scenario specific variables

# ----- gamY: Loop over G_scenarios -----

  uTKmargNoBound_scen_exists_dummy[l,es,d,t,scen] = (((t1.val <= t.val and t.val <= tEnd.val and d1switch_energy_technology)) and uTKmargNoBound_exists_dummy[l,es,d,t]);

  uTKmarg_scen_exists_dummy[l,es,d,t,scen] = (((t1.val <= t.val and t.val <= tEnd.val and d1switch_energy_technology)) and uTKmarg_exists_dummy[l,es,d,t]);

  sqT_scen_exists_dummy[l,es,d,t,scen] = (((t1.val <= t.val and t.val <= tEnd.val and d1switch_energy_technology)) and sqT_exists_dummy[l,es,d,t]);

  pESmarg_scen_exists_dummy[es,d,t,scen] = (((t1.val <= t.val and t.val <= tEnd.val and d1switch_energy_technology)) and pESmarg_exists_dummy[es,d,t]);


# 2.3 Initial Value Assignment
# Set starting value of scenario specific variables equal to their original counterparts

# ----- gamY: Loop over energy_technology_endogenous_core -----

  uTKmargNoBound_scen.l[l,es,d,t,scen]$(((t1.val <= t.val and t.val <= tEnd.val and d1switch_energy_technology)) and uTKmargNoBound_exists_dummy[l,es,d,t]) = uTKmargNoBound.l[l,es,d,t];

  uTKmarg_scen.l[l,es,d,t,scen]$(((t1.val <= t.val and t.val <= tEnd.val and d1switch_energy_technology)) and uTKmarg_exists_dummy[l,es,d,t]) = uTKmarg.l[l,es,d,t];

  sqT_scen.l[l,es,d,t,scen]$(((t1.val <= t.val and t.val <= tEnd.val and d1switch_energy_technology)) and sqT_exists_dummy[l,es,d,t]) = sqT.l[l,es,d,t];

  pESmarg_scen.l[es,d,t,scen]$(((t1.val <= t.val and t.val <= tEnd.val and d1switch_energy_technology)) and pESmarg_exists_dummy[es,d,t]) = pESmarg.l[es,d,t];


# 2.4 Scenario Model Creation

# ----- gamY: Initialize B_scenarios equation block -----

# ----- gamY: Initialize None group -----

EQUATION E_uTKmargNoBound_l_es_d_scen[l,es,d,t,scen];
E_uTKmargNoBound_l_es_d_scen[l,es,d,t,scen]$([(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology)) and utkmargnobound_exists_dummy[l,es,d,t])])..   pESmarg_scen[es,d,t,scen]   =E=   
    sum(e$(d1pEpj[es,e,d,t] and d1uTE[l,es,e,d,t]), uTE[l,es,e,d,t]*pEpj_marg[es,e,d,t]) + 
    uTKmargNoBound_scen[l,es,d,t,scen]*pTK[d,t];
EQUATION E_uTKmarg_l_es_d_scen[l,es,d,t,scen];
E_uTKmarg_l_es_d_scen[l,es,d,t,scen]$([(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology)) and utkmarg_exists_dummy[l,es,d,t])])..   uTKmarg_scen[l,es,d,t,scen]   =E=   max(0.0001, uTKmargNoBound_scen[l,es,d,t,scen]);
EQUATION E_sqT_l_es_d_scen[l,es,d,t,scen];
E_sqT_l_es_d_scen[l,es,d,t,scen]$([(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology)) and sqt_exists_dummy[l,es,d,t])])..   sqT_scen[l,es,d,t,scen]   =E=   
    sqTPotential[l,es,d,t]*errorf((log(((uTKmarg_scen[l,es,d,t,scen]/uTKexp[l,es,d,t])**2)**0.5) + 0.5*eP[l,es,d,t]**2)/eP[l,es,d,t]) 
;
EQUATION E_pESmarg_es_d_scen[es,d,t,scen];
E_pESmarg_es_d_scen[es,d,t,scen]$([(((t1.val <= t.val and t.val <= tend.val and d1switch_energy_technology)) and pesmarg_exists_dummy[es,d,t])])..   1   =E=   sum(l$(d1sqTPotential[l,es,d,t]), sqT_scen[l,es,d,t,scen]);

# ----- gamY: Initialize B_scenarios model -----
MODEL B_scenarios / 
E_uTKmargNoBound_l_es_d_scen, E_uTKmarg_l_es_d_scen, E_sqT_l_es_d_scen, E_pESmarg_es_d_scen
 /;

# ----------------------------------------------------------------------------------------------------------------------
# 3. Supply Curve Model
# ----------------------------------------------------------------------------------------------------------------------
# 3.1 Supply Curve Variables
$offlisting
Variable sqT_sum_scen[es,d,t,scen] "Smoothed aggregate supply curve" //;
SET sqT_sum_scen_exists_dummy[es,d,t,scen];
$onlisting


# 3.2 Supply Curve Equations

# ----- gamY: Initialize energy_technology_supply_curve_equations equation block -----

# ----- gamY: Initialize energy_technology_endogenous_supply_curve group -----
EQUATION E_sqT_sum_scen_es_d_t_scen[es,d,t,scen];
E_sqT_sum_scen_es_d_t_scen[es,d,t,scen]$(((t1.val <= t.val and t.val <= tend.val)) and sqt_sum_scen_exists_dummy[es,d,t,scen])..  sqT_sum_scen[es,d,t,scen]  =E=  sum(l$(d1sqTPotential[l,es,d,t]), sqT_scen[l,es,d,t,scen]);

# ----- gamY: Initialize energy_technology_supply_curve_equations model -----
MODEL energy_technology_supply_curve_equations / 
E_sqT_sum_scen_es_d_t_scen
 /;

# ----------------------------------------------------------------------------------------------------------------------
# 4. Model Assembly
# ----------------------------------------------------------------------------------------------------------------------
# 4.1 Model Definition

# ----- gamY: Initialize M_energy_technology_supply_curve model -----
MODEL M_energy_technology_supply_curve / 
E_uTKmargNoBound_l_es_d_scen, E_uTKmarg_l_es_d_scen, E_sqT_l_es_d_scen, E_sqT_sum_scen_es_d_t_scen
 /;
  
