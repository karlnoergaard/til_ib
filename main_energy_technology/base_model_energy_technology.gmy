                                      ;
EQUATION E_tqE_marg_es_e_d[es,e,d,t];
E_tqE_marg_es_e_d[es,e,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and tqe_marg_exists_dummy[es,e,d,t]).. 
        tqE_marg[es,e,d,t] 
