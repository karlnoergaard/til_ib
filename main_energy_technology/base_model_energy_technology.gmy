      vtM_i_d_calib.lo[i,d,t]$(vtM_i_d_calib.l[i,d,t]) = vtM_i_d_calib.lo[i,d,t] * fvt[t];
      vtM_i_d_calib.up[i,d,t]$(vtM_i_d_calib.l[i,d,t]) = vtM_i_d_calib.up[i,d,t] * fvt[t];
    
      jvY_i.l[i,t]$(jvY_i.l[i,t]) = jvY_i.l[i,t] * fvt[t];
      jvY_i.lo[i,t]$(jvY_i.l[i,t]) = jvY_i.lo[i,t] * fvt[t];
      jvY_i.up[i,t]$(jvY_i.l[i,t]) = jvY_i.up[i,t] * fvt[t];
    
      jvM_i.l[i,t]$(jvM_i.l[i,t]) = jvM_i.l[i,t] * fvt[t];
      jvM_i.lo[i,t]$(jvM_i.l[i,t]) = jvM_i.lo[i,t] * fvt[t];
      jvM_i.up[i,t]$(jvM_i.l[i,t]) = jvM_i.up[i,t] * fvt[t];
    
      vTSupply.l[l,es,d,t]$(vTSupply.l[l,es,d,t]) = vTSupply.l[l,es,d,t] * fvt[t];
      vTSupply.lo[l,es,d,t]$(vTSupply.l[l,es,d,t]) = vTSupply.lo[l,es,d,t] * fvt[t];
      vTSupply.up[l,es,d,t]$(vTSupply.l[l,es,d,t]) = vTSupply.up[l,es,d,t] * fvt[t];
    
      vES.l[es,d,t]$(vES.l[es,d,t]) = vES.l[es,d,t] * fvt[t];
      vES.lo[es,d,t]$(vES.l[es,d,t]) = vES.lo[es,d,t] * fvt[t];
      vES.up[es,d,t]$(vES.l[es,d,t]) = vES.up[es,d,t] * fvt[t];
    
      vESK.l[es,d,t]$(vESK.l[es,d,t]) = vESK.l[es,d,t] * fvt[t];
      vESK.lo[es,d,t]$(vESK.l[es,d,t]) = vESK.lo[es,d,t] * fvt[t];
      vESK.up[es,d,t]$(vESK.l[es,d,t]) = vESK.up[es,d,t] * fvt[t];
    
      vI_k_i_energy_tech.l[k,i,t]$(vI_k_i_energy_tech.l[k,i,t]) = vI_k_i_energy_tech.l[k,i,t] * fvt[t];
      vI_k_i_energy_tech.lo[k,i,t]$(vI_k_i_energy_tech.l[k,i,t]) = vI_k_i_energy_tech.lo[k,i,t] * fvt[t];
      vI_k_i_energy_tech.up[k,i,t]$(vI_k_i_energy_tech.l[k,i,t]) = vI_k_i_energy_tech.up[k,i,t] * fvt[t];
    
      vI_k_i_baseline.l[k,i,t]$(vI_k_i_baseline.l[k,i,t]) = vI_k_i_baseline.l[k,i,t] * fvt[t];
      vI_k_i_baseline.lo[k,i,t]$(vI_k_i_baseline.l[k,i,t]) = vI_k_i_baseline.lo[k,i,t] * fvt[t];
      vI_k_i_baseline.up[k,i,t]$(vI_k_i_baseline.l[k,i,t]) = vI_k_i_baseline.up[k,i,t] * fvt[t];
$onlisting
  INF_GROWTH_ADJUSTED = No;
 #Find ud af hvad, der går galt med de to her


  # ------------------------------------------------------------------------------
  # Initial values 
  # ------------------------------------------------------------------------------

   tCO2_ETS.l[t] = 750;
   tCO2_ETS2.l[t]= 375; 

   tCO2_xEmarg.l['23001',t] = 125;
   tCO2_xEmarg.l['23002',t] = 125;


   
  # ------------------------------------------------------------------------------
  # Dummies 
  # ------------------------------------------------------------------------------
    
    d1tE_duty[etaxes,es,e,d,t] = yes$((vtE_duty.l[etaxes,es,e,d,t] or (sameas[etaxes,'co2_tax'] and sum(em,tCO2_Emarg.l[em,es,e,d,t]))) and d1qEpj[es,e,d,t]);
    d1tE_duty_tot[d,t]         = yes$(sum((etaxes,es,e), d1tE_duty[etaxes,es,e,d,t]));
    d1tE_vat[es,e,d,t]         = yes$(vtE_vat.l[es,e,d,t] and pEpj_base.l[es,e,d,t]);
    d1tE_vat_tot[d,t]          = yes$(sum((es,e), d1tE_vat[es,e,d,t]));
 
    d1tCO2_E[em,es,e,d,t]      = yes$(tCO2_Emarg.l[em,es,e,d,t] and qEpj.l[es,e,d,t]);
    d1tCO2_xE[d,t]             = yes$(tCO2_xEmarg.l[d,t]);
    d1tCO2_ETS_E[em,es,e,d,t]  = yes$(qEmmE_BU.l[em,es,e,d,t] and CO2ubio[em] and qEpj.l[es,e,d,t] and in_ETS[es]);
    d1tCO2_ETS_E[em,es,e,d,t]$(qEmmE_BU.l[em,es,e,d,t] and CO2bio[em] and qEpj.l[es,e,d,t] and in_ETS[es] and natgas[e]) = yes;
    d1tCO2_ETS[i,t]             = yes$(sum((em,es,e), d1tCO2_ETS_E[em,es,e,i,t]));

    d1tCO2_ETS2_E[em,es,e,d,t]  = yes$(qEmmE_BU.l[em,es,e,d,t] and CO2ubio[em] and qEpj.l[es,e,d,t] and not in_ETS[es] and tCO2_ETS2.l[t] and t.val>=2028);
    d1tCO2_ETS2_E[em,es,e,d,t]$(qEmmE_BU.l[em,es,e,d,t] and CO2bio[em] and qEpj.l[es,e,d,t] and not in_ETS[es] and natgas[e] and tCO2_ETS2.l[t] and t.val>=2028) = yes;
    
    d1tCO2_ETS2[d,t]=yes$(sum((em,es,e), d1tCO2_ETS2_E[em,es,e,d,t]) and t.val>=2028);

    d1tE[es,e,d,t]             = yes$((sum(etaxes,d1tE_duty[etaxes,es,e,d,t])  or d1tE_vat[es,e,d,t] or sum(em,d1tCO2_ETS_E[em,es,e,d,t]) or sum(em, d1tCO2_ETS2_E[em,es,e,d,t])) and (pEpj_base.l[es,e,d,t] or pEpj_own.l[es,e,d,t]));
    d1tqEpj[es,e,d,t]          = yes$((sum(etaxes, d1tE_duty[etaxes,es,e,d,t]) or sum(em,d1tCO2_ETS_E[em,es,e,d,t]) or sum(em, d1tCO2_ETS2_E[em,es,e,d,t])) and d1qEpj[es,e,d,t] and not (pEpj_base.l[es,e,d,t] or pEpj_own.l[es,e,d,t]));

    d1pEpj[es,e,d,t]           = yes$(d1pEpj_base[es,e,d,t] or d1tqEpj[es,e,d,t] or d1pEpj_own[es,e,d,t]); #There is a price if a) There is a base-price or b) if the energy-good is taxed.

    #From production_CES_energydemand.gms
    d1pEpj_marg_NotinNest[es,e,i,t]$(d1pEpj[es,e,i,t] and process_special[es] and crudeoil[e] and i_refineries[i]) = yes; #Refinery feedstock of crude oil
	  d1pEpj_marg_NotinNest[es,e,i,t]$(d1pEpj[es,e,i,t] and process_special[es] and natgas_ext[e] and i_gasdistribution[i]) = yes; #Input of fossile natural gas in gas distribution sector
	  d1pEpj_marg_NotinNest[es,e,i,t]$(d1pEpj[es,e,i,t] and process_special[es] and biogas[e] and i_gasdistribution[i]) = yes; #Input of biogas for converting to natural gas in gas distribution sector
	  d1pEpj_marg_NotinNest[es,e,i,t]$(d1pEpj[es,e,i,t] and process_special[es] and el[e] and i_service_for_industries[i]) = yes; #Electricity for data centers (only applies when calibrated to Climate Outlook)

	  d1pEpj_marg_inNest[es,e,i,t]    = yes$(d1pEpj[es,e,i,t] and not d1pEpj_marg_NotinNest[es,e,i,t]);
	  d1pEpj_marg[es,e,i,t]           = yes$(d1pEpj_marg_inNest[es,e,i,t] or d1pEpj_marg_NotinNest[es,e,i,t]);

	  d1pEes[es,i,t] 			 				 = yes$(sum(e, d1pEpj_marg_inNest[es,e,i,t]));	

    #Households pay the statutory CO2-tax on their emissions, see calibration

	  d1pREmachine[i,t]            = yes$(sum(es$(not (heating[es] or transport[es])), d1pEes[es,i,t]));


# ----- gamY: ENDIF -----


