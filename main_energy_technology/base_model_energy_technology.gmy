EQUATION E_pEpj_foreign_es_e[es,e,t];
E_pEpj_foreign_es_e[es,e,t]$(((t1.val <= t.val and t.val <= tend.val)) and pepj_foreign_exists_dummy[es,e,t])..  pEpj_foreign[es,e,t]  =E=  pEpj_marg[es,e,'xEne',t];

# ----- gamY: Initialize exports_energy_calibration_equations model -----
MODEL exports_energy_calibration_equations / 
E_pEpj_foreign_es_e
 /;

