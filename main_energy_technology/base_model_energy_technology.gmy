EQUATION E_pM[t];
E_pM[t]$(((t1.val <= t.val and t.val <= tend.val)) and pm_exists_dummy[t])..  pM[t] * qM[t]  =E=  vM[t];
EQUATION E_qM[t];
E_qM[t]$(((t1.val <= t.val and t.val <= tend.val)) and qm_exists_dummy[t])..  qM[t] * pM[t-1]  =E=  sum(i, pM_i[i,t-1] * qM_i[i,t]);
EQUATION E_vtY_i_d[i,d,t];
E_vtY_i_d[i,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and vty_i_d_exists_dummy[i,d,t])..  vtY_i_d[i,d,t]  =E=  tY_i_d[i,d,t] * vY_i_d_base[i,d,t];
EQUATION E_vtM_i_d[i,d,t];
E_vtM_i_d[i,d,t]$(((t1.val <= t.val and t.val <= tend.val)) and vtm_i_d_exists_dummy[i,d,t])..  vtM_i_d[i,d,t]  =E=  tM_i_d[i,d,t] * vM_i_d_base[i,d,t];
EQUATION E_vtY_i[i,t];
E_vtY_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and vty_i_exists_dummy[i,t])..  vtY_i[i,t]  =E=  sum(d, vtY_i_d[i,d,t]);
EQUATION E_vtM_i[i,t];
E_vtM_i[i,t]$(((t1.val <= t.val and t.val <= tend.val)) and vtm_i_exists_dummy[i,t])..  vtM_i[i,t]  =E=  sum(d, vtM_i_d[i,d,t]);
EQUATION E_vtY[t];
E_vtY[t]$(((t1.val <= t.val and t.val <= tend.val)) and vty_exists_dummy[t])..  vtY[t]  =E=  sum(i, vtY_i[i,t]);
