EQUATION E_qCO2e_BU_energy_Corp_es_e_i[energy_corp,es,e,i,t];
E_qCO2e_BU_energy_Corp_es_e_i[energy_corp,es,e,i,t]$(((t1.val <= t.val and t.val <= tend.val)) and qco2e_bu_exists_dummy[energy_corp,es,e,i,t])..   qCO2e_BU[energy_Corp,es,e,i,t]    =E=   qemme_BU['CO2e',es,e,i,t]
                                            - qemme_BU['CO2e',es,e,i,t]$MapBunkering['CO2e',es,e,i]
                                            - qemme_BU['CO2e',es,e,i,t]$MapOtherDifferencesShips['CO2e',es,e,i]
                                            - qemme_BU['CO2e',es,e,i,t]$MapInternationalAviation['CO2e',es,e,i]
