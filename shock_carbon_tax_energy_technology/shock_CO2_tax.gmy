# ------------------------------------------------------------------------------
# Energy Technology Choice Model
# ------------------------------------------------------------------------------
# This partial model implements the technology choice model for energy services
# using a smooth transition approach with log-normal distributions.

# ------------------------------------------------------------------------------
# 1. Variable and Dummy Definitions
# ------------------------------------------------------------------------------

# ----- gamY: IF "tests_shock" == "variables": -----
# If condition evaluated to false
# ----- gamY: ENDIF -----
 # variables

# ------------------------------------------------------------------------------
# 2. Model Equations
# ------------------------------------------------------------------------------

# ----- gamY: IF "tests_shock" == "equations": -----
# If condition evaluated to false
# ----- gamY: ENDIF -----
 # equations

# ------------------------------------------------------------------------------
# 3. Data and Parameters
# ------------------------------------------------------------------------------

# ----- gamY: IF "tests_shock" == "exogenous_values": -----
# If condition evaluated to false
# ----- gamY: ENDIF -----
 # exogenous_values

# ------------------------------------------------------------------------------
# Starting values
# ------------------------------------------------------------------------------

# ----- gamY: IF "tests_shock" == "starting_values": -----
# If condition evaluated to false
# ----- gamY: ENDIF -----
 # starting_values

# ------------------------------------------------------------------------------
# 4. Calibration
# ------------------------------------------------------------------------------

# ----- gamY: IF "tests_shock" == "calibration": -----
# If condition evaluated to false
# ----- gamY: ENDIF -----
 # calibration

# ------------------------------------------------------------------------------
# Tests calibration
# ------------------------------------------------------------------------------

# ----- gamY: IF "tests_shock" == "tests_baseline": -----
# If condition evaluated to false
# ----- gamY: ENDIF -----
 # tests

# ------------------------------------------------------------------------------
# Tests shock
# ------------------------------------------------------------------------------

# ----- gamY: IF "tests_shock" == "tests_shock": -----


LOOP((es,i,t)$(t1.val <= t.val and t.val <= tEnd.val and d1qES[es,i,t] and sum((em,e), tCO2_Emarg_pj.l[em,es,e,i,t]-tCO2_Emarg_pj_baseline.l[em,es,e,i,t])>0 and d1switch_energy_technology),
  if (pREes_change.l[es,i,t] < 0,
    put_utility 'log' / 'WARNING: Negative change in price of energy service in the CGE model (continuing run)';
  );
);

LOOP((es,i,t)$(t1.val <= t.val and t.val <= tEnd.val and d1qES[es,i,t] and sum((em,e), tCO2_Emarg_pj.l[em,es,e,i,t]-tCO2_Emarg_pj_baseline.l[em,es,e,i,t])>0 and d1switch_energy_technology),
  if (pREes_change.l[es,i,t] > pREes_mechanic_change.l[es,i,t],
    put_utility 'log' / "WARNING: Change in price of energy service in the CGE model exceed mechanical price change (continuing run)";
  );
);

# Test that price changes in the CGE model are the same as in the energy technology model
# when all energy-technology inputs are linked to existing CGE energy activity.
LOOP((es,i,t)$(t1.val <= t.val and t.val <= tEnd.val and not jqESE_phaseout[t] and d1qES[es,i,t] and not sum(e$(d1qES_e[es,e,i,t] and d1pEpj_marg[es,e,i,t] and not qEpj_exists_dummy[es,e,i,t]), 1) and sum((em,e), tCO2_Emarg_pj.l[em,es,e,i,t]-tCO2_Emarg_pj_baseline.l[em,es,e,i,t])>0 and d1switch_energy_technology),
  ABORT$(abs(pREes_change.l[es,i,t] - pES_change.l[es,i,t]) > 1e-5)
        'Price change in the CGE model does not match price change in the energy technology model');


# ----- gamY: ENDIF -----
 # tests
    
# ----- gamY: ENDIF -----

  
    
