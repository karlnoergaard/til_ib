  parameter test_sector_balance[t];
  
    test_sector_balance[t] = abs(sum(sector, vNetInterests.l[sector,t]));
    ABORT$(smax(t, test_sector_balance[t]) > 1e-6) "vNetInterests do not sum to zero.", test_sector_balance;
  
    test_sector_balance[t] = abs(sum(sector, vNetDividends.l[sector,t]));
    ABORT$(smax(t, test_sector_balance[t]) > 1e-6) "vNetDividends do not sum to zero.", test_sector_balance;
  
    test_sector_balance[t] = abs(sum(sector, vNetRevaluations.l[sector,t]));
    ABORT$(smax(t, test_sector_balance[t]) > 1e-6) "vNetRevaluations do not sum to zero.", test_sector_balance;
  
    test_sector_balance[t] = abs(sum(sector, vNetDebtInstruments.l[sector,t]));
    ABORT$(smax(t, test_sector_balance[t]) > 1e-6) "vNetDebtInstruments do not sum to zero.", test_sector_balance;
  
    test_sector_balance[t] = abs(sum(sector, vNetEquity.l[sector,t]));
    ABORT$(smax(t, test_sector_balance[t]) > 1e-6) "vNetEquity do not sum to zero.", test_sector_balance;
  
    test_sector_balance[t] = abs(sum(sector, vNetFinAssets.l[sector,t]));
    ABORT$(smax(t, test_sector_balance[t]) > 1e-6) "vNetFinAssets do not sum to zero.", test_sector_balance;
  

