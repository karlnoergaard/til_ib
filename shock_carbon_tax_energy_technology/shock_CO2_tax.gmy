uTKmarg_scen.up[l,es,d,t,scen]$((((t1.val <= t.val and t.val <= tEnd.val and d1switch_energy_technology)) and uTKmarg_exists_dummy[l,es,d,t])) = inf;
sqT_scen.lo[l,es,d,t,scen]$((((t1.val <= t.val and t.val <= tEnd.val and d1switch_energy_technology)) and sqT_exists_dummy[l,es,d,t])) = -inf;
