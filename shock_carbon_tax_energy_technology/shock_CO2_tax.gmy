tCO2_ETS_pj.lo[em,es,e,d,t]$((((((t1.val <= t.val and t.val <= tEnd.val) and (d1tCO2_ETS_E[em,es,e,d,t] and natgas[e] and CO2ubio[em])) and tCO2_ETS_pj_exists_dummy[em,es,e,d,t]) and i[d]) or (((((t1.val <= t.val and t.val <= tEnd.val) and (d1tCO2_ETS_E[em,es,e,d,t] and natgas[e] and CO2bio[em])) and tCO2_ETS_pj_exists_dummy[em,es,e,d,t]) and i[d]) or ((((t1.val <= t.val and t.val <= tEnd.val) and (d1tCO2_ETS_E[em,es,e,d,t] and not natgas[e])) and tCO2_ETS_pj_exists_dummy[em,es,e,d,t]) and i[d])))) = -inf;
