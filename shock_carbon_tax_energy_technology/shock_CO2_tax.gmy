# ----- gamY: $UNFIX G_energy_technology_supply_curve_endo; -----
$offlisting
uTKmargNoBound_scen.lo[l,es,d,t,scen]$((((t1.val <= t.val and t.val <= tEnd.val and d1switch_energy_technology)) and uTKmargNoBound_exists_dummy[l,es,d,t])) = -inf;
